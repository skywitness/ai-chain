---
/**
 * /dev/components/ — living style guide for the design system (development only: routed by
 * ./[page].astro, which emits nothing in production builds).
 * Uses small fake data. Owner: design-system agent.
 */
import { existsSync, readFileSync } from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import ProfileLayout from '../../layouts/ProfileLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Button from '../../components/ui/Button.astro';
import Card from '../../components/ui/Card.astro';
import DataAsOf from '../../components/ui/DataAsOf.astro';
import Icon from '../../components/ui/Icon.astro';
import Stat from '../../components/ui/Stat.astro';
import Tag from '../../components/ui/Tag.astro';
import { ICONS, type IconName } from '../../components/ui/icons';
import TOC from '../../components/layout/TOC.astro';
import ThemeToggle from '../../components/layout/ThemeToggle.astro';
import LogoMark from '../../components/layout/LogoMark.astro';
import { mdxComponents as M } from '../../components/content/mdx-components';
import PrereqBox from '../../components/content/PrereqBox.astro';
import NextSteps from '../../components/content/NextSteps.astro';
import SourcesList from '../../components/content/SourcesList.astro';
import { LAYERS, SEGMENTS } from '../../lib/collections';
import { learnHref, sectionHref, withBase } from '../../lib/paths';
import type { SourceT } from '../../schemas/common';

const {
  Term,
  Cite,
  CompanyChip,
  ModelChip,
  SegmentChip,
  LearnLink,
  TrendLink,
  Callout,
  DeepDive,
  LevelSection,
  MathTeX,
  FlowSteps,
  Compare,
  StatGrid,
  KeyTakeaways,
  Figure,
  Scene3D,
  BarChart,
  LineChart,
} = M;

const sources: SourceT[] = [
  {
    key: 'demo-annual',
    title: '2025 Annual Report',
    publisher: '示範半導體公司',
    url: 'https://example.com/ir/annual-2025',
    type: 'annual-report',
    lang: 'en',
    published: '2026-03-12',
    accessed: '2026-10-06',
  },
  {
    key: 'demo-monthly',
    title: '2026 年 8 月營業收入報告',
    publisher: '公開資訊觀測站',
    url: 'https://mops.example.com/monthly',
    type: 'monthly-revenue',
    lang: 'zh-TW',
    published: '2026-09-10',
    accessed: '2026-10-06',
    note: '月營收為自結數，未經會計師查核。',
  },
  {
    key: 'demo-paper',
    title: 'Scaling Laws for Neural Language Models',
    publisher: 'arXiv',
    url: 'https://arxiv.org/abs/2001.08361',
    type: 'paper',
    lang: 'en',
    published: '2020-01-23',
    accessed: '2026-10-06',
    archiveUrl: 'https://web.archive.org/web/2026/https://arxiv.org/abs/2001.08361',
  },
];

const sections = [
  { slug: 'sg-tokens', text: '色彩 tokens' },
  { slug: 'sg-type', text: '字級與排版' },
  { slug: 'sg-prose', text: '內文排版（prose）' },
  { slug: 'sg-callouts', text: '提示框' },
  { slug: 'sg-levels', text: '分級段落與展開' },
  { slug: 'sg-diagrams', text: '流程、比較與數字' },
  { slug: 'sg-charts', text: '圖表' },
  { slug: 'sg-article', text: '文章元件' },
  { slug: 'sg-ui', text: '介面元件' },
  { slug: 'sg-cards', text: '卡片與版面' },
].map((s) => ({ depth: 2, slug: s.slug, text: s.text }));

const surfaceTokens = ['--c-bg', '--c-bg-elev', '--c-bg-sunken', '--c-border', '--c-border-strong'];
const textTokens = ['--c-fg', '--c-fg-muted', '--c-fg-subtle', '--c-link', '--c-accent'];
const semanticTokens = ['--c-accent', '--c-focus', '--c-pos', '--c-neg', '--c-warn', '--c-estimate', '--level-1', '--level-2', '--level-3'];
const chartTokens = Array.from({ length: 8 }, (_, i) => `--chart-${i + 1}`);
const sceneTokens = ['--scene-bg', '--scene-fg', '--scene-grid', '--scene-muted', '--scene-highlight', '--scene-flow', '--scene-power', '--scene-heat', '--scene-coolant', '--scene-optic', '--scene-tw-accent'];
const iconNames = Object.keys(ICONS) as IconName[];
const typeScale = [
  ['--fs-3xl', '產業鏈全景 3xl'],
  ['--fs-2xl', '晶圓代工與先進封裝 2xl'],
  ['--fs-xl', '記憶體牆與 HBM xl'],
  ['--fs-l', '先進封裝入門：CoWoS 與 Chiplet l'],
  ['--fs-m', '台積電 2026 年第二季營收年增 38.6%，主要來自 AI 加速器需求。m（內文 17px）'],
  ['--fs-s', '資料截至 2026-10-06，數字均附來源。s'],
  ['--fs-xs', '估計值以斜線標示，不納入排名。xs'],
];

// Layout previews (dev server only). Prerendered pages never see query strings, so the preview is chosen by a
// scratch file: write 'article' or 'profile' to research/tmp/design-system/layout-demo.txt, delete it to go back.
const DEMO_FILE = 'research/tmp/design-system/layout-demo.txt';
const demo = import.meta.env.DEV && existsSync(DEMO_FILE) ? readFileSync(DEMO_FILE, 'utf8').trim() : null;
const articleHeadings = [
  { depth: 2, slug: 'one-line', text: '一句話解釋' },
  { depth: 2, slug: 'analogy', text: '生活化比喻' },
  { depth: 2, slug: 'principle', text: '原理' },
  { depth: 3, slug: 'principle-tsv', text: 'TSV 與堆疊' },
  { depth: 2, slug: 'chain', text: '與產業鏈的連結' },
];
---

{demo === 'article' ? (
  <ArticleLayout
    title="記憶體牆與 HBM"
    subtitle="為什麼 AI 晶片越來越受限於記憶體頻寬，以及 HBM 如何把 DRAM 疊起來"
    description="說明記憶體牆的成因、HBM 的堆疊結構與三大供應商，並連結到產業鏈中的記憶體與先進封裝環節。"
    kicker="學習路徑 · 晶片與硬體"
    level={2}
    minutes={14}
    headings={articleHeadings}
    prereqs={['gpu-architecture', 'why-gpus']}
    keyTakeaways={['AI 晶片的瓶頸常常是記憶體頻寬，而不是算力。', 'HBM 以 TSV 垂直堆疊 DRAM，貼在 GPU 旁邊。', '先進封裝產能決定了 AI 加速器能出貨多少。']}
    sources={sources}
    lastVerified="2026-10-06"
    updated="2026-10-06"
    breadcrumbs={[{ label: '學習路徑', href: sectionHref('learn') }, { label: '記憶體牆與 HBM' }]}
    noindex
  >
    <h2 id="one-line">一句話解釋</h2>
    <p>當運算單元越來越快，資料卻來不及從記憶體送過來，整顆晶片就只能等待，這就是<Term id="memory-wall">記憶體牆</Term>。</p>
    <h2 id="analogy">生活化比喻</h2>
    <Callout type="analogy" title="廚師與食材">廚師（GPU）切菜再快，如果食材（資料）從倉庫送來的速度太慢，餐廳還是出不了菜。</Callout>
    <h2 id="principle">原理</h2>
    <p>以 <Term id="hbm">HBM</Term> 為例，它把 8 到 12 層 DRAM 晶粒堆疊起來<Cite k="demo-annual" />，再放在 GPU 旁邊的矽中介層上。</p>
    <h3 id="principle-tsv">TSV 與堆疊</h3>
    <p>每一層晶粒都以矽穿孔連接，頻寬因此遠高於傳統 DDR 記憶體<Cite k="demo-paper" />。</p>
    <DeepDive title="深入一點：為什麼 HBM 需要先進封裝？"><p>HBM 與 GPU 之間有上千條訊號線，只能透過矽中介層或橋接晶粒連接。</p></DeepDive>
    <h2 id="chain">與產業鏈的連結</h2>
    <p>HBM 由 <CompanyChip id="sk-hynix" />、<CompanyChip id="samsung-electronics" /> 與 <CompanyChip id="micron" /> 供應，屬於 <SegmentChip id="memory-storage" /> 環節。</p>
    <NextSteps slot="next" items={[{ learn: 'hbm-deep', kicker: '準備好深入了嗎？' }, { segment: 'memory-storage' }, { trend: 'hbm4-custom-base-die' }]} prev={{ href: learnHref('semiconductor-process-nodes'), title: '製程節點' }} next={{ href: learnHref('networking-for-ai'), title: 'AI 叢集網路' }} />
  </ArticleLayout>
) : demo === 'profile' ? (
  <ProfileLayout
    title="示範晶圓代工（Demo Foundry）：產品、技術與營收"
    description="示範用公司檔案，用來檢視 ProfileLayout 的版面。"
    name="示範晶圓代工"
    nameAlt="Demo Foundry Co."
    kicker="公司資料庫 · 晶圓代工與先進封裝"
    segment="foundry-packaging"
    summary="全球最大的示範晶圓代工廠，量產最先進製程並提供 CoWoS 先進封裝；幾乎所有 AI 加速器都由其製造。"
    aliases={['Demo Foundry', 'DFC', '9999', '示範代工']}
    facts={[
      { label: '總部', value: '新竹' },
      { label: '成立', value: '1987 年' },
      { label: '上市', value: 'TWSE: 9999', note: 'NYSE ADR: DFC' },
      { label: '員工', value: '83,000 人', note: '2025 年底' },
      { label: '近四季營收', value: '新台幣 3.6 兆元', note: '≈ 1,150 億美元' },
      { label: '官方網站', value: 'example.com', href: 'https://example.com' },
    ]}
    lastVerified="2026-10-06"
    sources={sources}
    breadcrumbs={[{ label: '公司資料庫', href: sectionHref('companies') }, { label: '示範晶圓代工' }]}
    noindex
  >
    <Fragment slot="badges">
      <Badge tone="accent">一線</Badge>
      <Badge>上市</Badge>
      <Badge tone="info">完整檔案</Badge>
      <Badge segment="foundry-packaging">代工封裝</Badge>
    </Fragment>
    <section class="prose">
      <h2 id="overview">公司概況</h2>
      <p>示範晶圓代工專注於晶圓製造，不設計自有品牌晶片<Cite k="demo-annual" />。2026 年第二季營收年增 38.6%<Cite k="demo-monthly" />。</p>
      <StatGrid items={[{ label: '2026 Q2 營收', value: '9,337', unit: '億元', delta: 38.6, deltaLabel: '年增' }, { label: '毛利率', value: '58.6%' }, { label: '先進製程占比', value: '74%', note: '7 奈米以下' }]} />
      <h2 id="products">產品與技術</h2>
      <p>主要產品包含 N3、N2 製程與 CoWoS 封裝服務。</p>
    </section>
  </ProfileLayout>
) : (

<BaseLayout
  title="元件樣式指南"
  description="AI 產業鏈全景設計系統的元件、色彩與排版樣式指南（開發用頁面）。"
  noindex
  pagefind={false}
  sources={sources}
  breadcrumbs={[{ label: '開發工具' }, { label: '元件樣式指南' }]}
>
  <div class="container sg">
    <header class="page-head">
      <p class="page-head__kicker">設計系統 · 開發用頁面</p>
      <h1>元件樣式指南</h1>
      <p class="page-head__lede">
        「編輯式技術地圖集」的視覺語言：淺色主題是溫暖的紙白與墨色文字，深色主題是深墨藍底與發光的環節色。切換右上角的主題按鈕，或使用下方按鈕檢視兩種主題。
      </p>
      <div class="cluster">
        <ThemeToggle showLabel />
        <Badge tone="warn">不會被搜尋引擎索引</Badge>
        <DataAsOf date="2026-10-06" />
      </div>
    </header>

    <div class="sg__grid">
      <aside class="sg__aside">
        <div class="sg__aside-sticky">
          <TOC headings={sections} title="章節" />
        </div>
      </aside>

      <div class="sg__main">
        <!-- ───────────── Tokens ───────────── -->
        <section class="sg__section" aria-labelledby="sg-tokens">
          <h2 id="sg-tokens">色彩 tokens</h2>
          <p class="sg__desc">同一組 token 在淺色與深色主題各有一組數值；元件只使用 token，不寫死色碼。下方左右並排為兩種主題的「主題島」。</p>
          <div class="sg__islands">
            {
              (['light', 'dark'] as const).map((theme) => (
                <div class="sg__island" data-theme={theme}>
                  <p class="sg__island-title">{theme === 'light' ? '淺色主題' : '深色主題'}</p>
                  <p class="sg__group-label">表面與框線</p>
                  <ul class="sg__swatches" role="list">
                    {surfaceTokens.map((t) => (
                      <li>
                        <span class="sg__chip" style={`background: var(${t})`} />
                        <code>{t}</code>
                      </li>
                    ))}
                  </ul>
                  <p class="sg__group-label">文字</p>
                  <ul class="sg__swatches" role="list">
                    {textTokens.map((t) => (
                      <li>
                        <span class="sg__text" style={`color: var(${t})`}>
                          文字 Aa
                        </span>
                        <code>{t}</code>
                      </li>
                    ))}
                  </ul>
                  <p class="sg__group-label">語意色</p>
                  <ul class="sg__swatches" role="list">
                    {semanticTokens.map((t) => (
                      <li>
                        <span class="sg__chip" style={`background: var(${t})`} />
                        <code>{t}</code>
                      </li>
                    ))}
                  </ul>
                  <p class="sg__group-label">五層</p>
                  <ul class="sg__bars" role="list">
                    {[...LAYERS].reverse().map((l) => (
                      <li>
                        <span class="sg__bar" style={`background: ${l.color}`} />
                        <span>{l.title}</span>
                        <code>--layer-{l.id}</code>
                      </li>
                    ))}
                  </ul>
                  <p class="sg__group-label">14 環節</p>
                  <ul class="sg__segs" role="list">
                    {SEGMENTS.map((s) => (
                      <li>
                        <span class="sg__dot" style={`background: ${s.color}`} />
                        <span>
                          {s.order}. {s.short}
                        </span>
                      </li>
                    ))}
                  </ul>
                  <p class="sg__group-label">圖表類別色（固定順序）</p>
                  <ul class="sg__row" role="list">
                    {chartTokens.map((t, i) => (
                      <li class="sg__chartchip" style={`background: var(${t})`} title={t}>
                        {i + 1}
                      </li>
                    ))}
                  </ul>
                  <p class="sg__group-label">3D 場景</p>
                  <ul class="sg__row" role="list">
                    {sceneTokens.map((t) => (
                      <li class="sg__scenechip" style={`background: var(${t})`} title={t} />
                    ))}
                  </ul>
                  <div class="sg__island-demo">
                    <Badge level={1} />
                    <Badge level={2} />
                    <Badge level={3} />
                    <Badge tone="estimate">估計</Badge>
                    <Badge tone="pos">年增</Badge>
                    <Badge tone="neg">年減</Badge>
                    <Button variant="primary" size="s">主要按鈕</Button>
                    <a href="#sg-tokens">文字連結</a>
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <!-- ───────────── Type ───────────── -->
        <section class="sg__section" aria-labelledby="sg-type">
          <h2 id="sg-type">字級與排版</h2>
          <p class="sg__desc">系統中文字體（蘋方、Noto Sans TC、微軟正黑體），不下載網路字型。字級以 clamp() 隨視窗流動；內文 17px／行高 1.8。</p>
          <ul class="sg__type" role="list">
            {
              typeScale.map(([t, sample]) => (
                <li>
                  <code>{t}</code>
                  <span style={`font-size: var(${t}); font-weight: ${t === '--fs-m' || t === '--fs-s' || t === '--fs-xs' ? 400 : 700}`}>{sample}</span>
                </li>
              ))
            }
          </ul>
          <p class="sg__desc">
            等寬字 <code>var(--font-mono)</code>：<code>FY2027-Q2</code>、<kbd>Ctrl K</kbd>；表格數字使用 tabular-nums。
          </p>
        </section>

        <!-- ───────────── Prose ───────────── -->
        <section class="sg__section" aria-labelledby="sg-prose">
          <h2 id="sg-prose">內文排版（prose）</h2>
          <div class="prose sg__prose">
            <p>
              AI 加速器的效能，越來越受限於記憶體頻寬，而不只是運算單元的數量。這就是所謂的<Term id="memory-wall">記憶體牆</Term>
              。為了解決它，業界把多顆 DRAM 晶粒垂直堆疊成 <Term id="hbm">HBM</Term>，再透過 <Term
                id="cowos-demo"
                term="CoWoS"
                zh="基板上晶圓上晶片封裝"
                en="Chip on Wafer on Substrate"
                level={2}
                short="台積電的 2.5D 先進封裝，把 GPU 與 HBM 並排放在矽中介層上，是 AI 晶片的關鍵產能瓶頸。"
              >CoWoS</Term> 與 GPU 封裝在一起<Cite k="demo-annual" />。
            </p>
            <p>
              第二次出現的 <Term id="hbm">HBM</Term> 只是一般文字，不會重複出現互動卡片。台灣廠商如 <CompanyChip id="tsmc" />、<CompanyChip id="nvidia">輝達</CompanyChip>
              與 <CompanyChip id="not-a-company">不存在的公司</CompanyChip> 會以小卡呈現；模型用 <ModelChip id="anthropic-claude" />，環節用 <SegmentChip id="memory-storage" /> 或 <SegmentChip
                id="foundry-packaging"
                short
              />。延伸閱讀：<LearnLink id="memory-and-hbm" />、<TrendLink id="hbm4-custom-base-die" />。月營收數字請見<Cite k="demo-monthly" />。
            </p>
            <h3>三級標題：為什麼頻寬比算力更重要</h3>
            <p>
              以 2026 年的旗艦 GPU 為例，<strong>每秒可讀取 8 TB 以上的資料</strong>，但模型推論時仍有大量時間在等待權重從記憶體搬出來。<em>強調</em>使用著重號而不是斜體。
            </p>
            <ul>
              <li>SRAM：最快、最貴，位於晶片內部。</li>
              <li>HBM：堆疊在 GPU 旁邊，頻寬最高的外部記憶體。</li>
              <li>DDR5／LPDDR5X：容量較大，頻寬較低。</li>
            </ul>
            <ol>
              <li>設計晶片並完成光罩。</li>
              <li>在晶圓廠進行數百道製程。</li>
              <li>封裝、測試後出貨。</li>
            </ol>
            <blockquote><p>「先進封裝已經從後段製程，變成決定 AI 晶片產能的核心環節。」</p></blockquote>
            <table>
              <thead>
                <tr><th>公司</th><th>環節</th><th align="right">2026 Q2 營收</th><th align="right">年增率</th><th>備註</th></tr>
              </thead>
              <tbody>
                <tr><td>示範晶圓代工</td><td>代工封裝</td><td align="right">9,337 億元</td><td align="right">+38.6%</td><td>新台幣，財報數字</td></tr>
                <tr><td>示範記憶體廠</td><td>記憶體</td><td align="right">93.0 億美元</td><td align="right">+47.2%</td><td>會計年度與日曆年度不同</td></tr>
                <tr><td>示範 AI 新創</td><td>基礎模型</td><td align="right">≈ 40 億美元</td><td align="right">—</td><td>估計值（年化營收）</td></tr>
              </tbody>
            </table>
            <p>行內程式碼如 <code>withBase('/learn/')</code>，以及數學式 <MathTeX tex="E = mc^2" />。</p>
            <MathTeX tex={String.raw`R = k_1 \frac{\lambda}{\mathrm{NA}}`} display label="解析度 R 等於 k1 乘以波長除以數值孔徑" />
          </div>
        </section>

        <!-- ───────────── Callouts ───────────── -->
        <section class="sg__section prose" aria-labelledby="sg-callouts">
          <h2 id="sg-callouts">提示框</h2>
          <Callout type="info" title="什麼是環節？">本站把 AI 產業鏈分成五層十四個環節，每家公司都有一個主要環節。</Callout>
          <Callout type="tip">閱讀數字時，先看資料截至日期與幣別。</Callout>
          <Callout type="warn" title="估計值">私人公司的營收多半是媒體估計，本站以斜線與「估計」標示，不納入排名。</Callout>
          <Callout type="analogy" title="把晶圓廠想成印刷廠">
            <p>光罩像是印刷用的版，晶圓是紙，微影機則是把圖案一層一層「印」上去的機器。</p>
          </Callout>
