---
/**
 * /learn/ — 學習路徑：由淺入深看懂 AI. Owner: pages-learn agent.
 * Mountain scene (curriculum data), the intro (pages entry "learn-intro"), three suggested routes,
 * and the accessible 2D board: track filter + three level columns with prerequisite chips and
 * per-viewer ✓ read marks (localStorage, src/client/progress.ts).
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import SourcesList from '../../components/content/SourcesList.astro';
import { mdxComponents } from '../../components/content/mdx-components';
import { registerSources } from '../../components/content/page-state';
import LearnScene from '../../components/learn/LearnScene.astro';
import LearnBoard from '../../components/learn/LearnBoard.astro';
import PathCards from '../../components/learn/PathCards.astro';
import LearnMap from '../../components/learn/LearnMap.astro';
import { getLearnItems, getSuggestedPaths, sceneExists, setSceneAutoload } from '../../components/learn/learn-data';
import { LEVELS, safeEntry } from '../../lib/collections';
import { learnHref } from '../../lib/paths';
import { canonicalUrl, type JsonLd } from '../../lib/seo';
import { curriculumSceneData } from '../../lib/scene-data/curriculum';

const TITLE = '學習路徑：由淺入深看懂 AI';
const items = await getLearnItems();
const paths = getSuggestedPaths(items);
const total = items.length;
const first = items[0];
const levelCounts = LEVELS.map((l) => ({ ...l, n: items.filter((i) => i.level === l.level).length }));
const trackCount = new Set(items.map((i) => i.track)).size;

// Intro copy from src/content/pages/learn-intro.mdx (falls back to built-in copy while it is missing).
const intro = await safeEntry('pages', 'learn-intro');
let IntroContent: Awaited<ReturnType<typeof render>>['Content'] | undefined;
if (intro) {
  try {
    IntroContent = (await render(intro)).Content;
  } catch (err) {
    console.warn(`[learn] could not render pages/learn-intro: ${(err as Error).message}`);
  }
}
const introData = IntroContent ? intro?.data : undefined;
// The meta description covers the whole path (the intro entry's own description only covers how to read it).
const description =
  `從什麼是 AI、晶片怎麼做，到 Transformer、先進封裝與 AI 資本支出：${total} 篇文章分成入門、進階、深入三個難度，標示建議先讀的文章與三條建議路線。`;
const introSources = introData?.sources ?? [];
const introTitle = introData?.title?.trim() || '怎麼讀這條學習路徑';
// Cite numbers in the intro must match the SourcesList order (register before the body renders).
registerSources(Astro, introSources);
const components = { ...mdxComponents, Scene3D: LearnScene };

const hasMountain = sceneExists('learn-mountain');
const sceneData = hasMountain ? curriculumSceneData(items) : [];
// The mountain is the page's one autoloading scene (scenes inside the intro stay click-to-load).
setSceneAutoload(Astro, hasMountain ? { id: 'learn-mountain' } : null);
const mapCaption = `學習地圖：由下往上是入門、進階、深入三層台地，共 ${total} 篇文章，每一層依主題分組、組內依編號排列；線條連到建議先讀的文章，虛線圈表示內容整理中。點選節點即可開啟文章。`;

const itemList: JsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: TITLE,
  numberOfItems: total,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  itemListElement: items.map((it, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: it.title,
    url: canonicalUrl(learnHref(it.slug), Astro.site),
  })),
};
---

<BaseLayout
  title={TITLE}
  description={description}
  breadcrumbs={[{ label: '學習路徑' }]}
  section="learn"
  pagefind={false}
  jsonLd={itemList}
  sources={introSources}
>
  <div class="container lp">
    <header class="lp-head" data-pagefind-body>
      <span hidden data-pagefind-filter="類型:文章"></span>
      <h1 class="lp-head__title" data-pagefind-weight="10">
        <span class="lp-nb">學習路徑：</span><span class="lp-nb">由淺入深看懂 AI</span>
      </h1>
      <p class="lp-head__lede">
        從「AI 是什麼」到先進封裝、HBM 與 AI 資本支出：照著難度一步步讀，每篇都標出建議先讀的文章，不用一次懂全部。
      </p>
      <dl class="lp-stats">
        <div>
          <dt>文章</dt>
          <dd><strong>{total}</strong> 篇</dd>
        </div>
        {
          levelCounts.map((l) => (
            <div style={`--c: ${l.color}`}>
              <dt>{l.label}</dt>
              <dd>
                <strong>{l.n}</strong> 篇
              </dd>
            </div>
          ))
        }
        <div>
          <dt>主題</dt>
          <dd><strong>{trackCount}</strong> 個</dd>
        </div>
      </dl>
      <div class="lp-head__cta">
        {
          first && (
            <a class="lp-btn lp-btn--primary" href={learnHref(first.slug)} data-continue data-first-href={learnHref(first.slug)}>
              <span data-continue-label>從第一篇開始</span>
              <Icon name="arrow-right" />
            </a>
          )
        }
        <a class="lp-btn" href="#all-articles">
          看全部文章
          <Icon name="chevron-down" />
        </a>
      </div>
    </header>

    <div class="lp-scene">
      {
        hasMountain ? (
          <>
            <LearnScene
              id="learn-mountain"
              height="hero"
              data={sceneData}
              caption={`學習之山：入門、進階、深入三層台地上的 ${total} 篇文章，線條是建議先讀的路徑。點選節點即可開啟文章。`}
            />
            <details class="lp-map-alt">
              <summary class="lp-map-alt__summary">
                <Icon name="layers" />
                改看平面學習地圖
              </summary>
              <div class="lp-map-alt__body">
                <LearnMap items={items} caption={mapCaption} />
              </div>
            </details>
          </>
        ) : (
          <LearnMap items={items} caption={mapCaption} />
        )
      }
    </div>

    <section class="lp-intro" aria-labelledby="lp-intro-title" data-pagefind-body>
      <div class="lp-intro__text">
        <h2 class="lp-h2" id="lp-intro-title">{introTitle}</h2>
        {
          IntroContent ? (
            <div class="prose lp-intro__prose">
              <IntroContent components={components} />
            </div>
          ) : (
            <div class="prose lp-intro__prose">
              <p>
                這裡把理解 AI 產業鏈需要的背景知識，排成一條由淺入深的路。入門篇不需要任何技術背景，用生活化的比喻說明 AI、晶片與資料中心；進階篇拆開模型與硬體的運作方式；深入篇則談產業前沿的技術與經濟問題。
              </p>
              <p>
                你可以照著編號順序讀，也可以從下方三條建議路線挑一條，只讀自己最關心的主題。每篇文章最後都有「下一步」，告訴你接著讀什麼，以及它和產業鏈哪一個環節有關。
              </p>
            </div>
          )
        }
      </div>
      <aside class="lp-how" aria-label="使用說明">
        <ol class="lp-how__list" role="list">
          <li>
            <span class="lp-how__n" aria-hidden="true">1</span>
            <div>
              <p class="lp-how__t">由淺入深</p>
              <p class="lp-how__d">入門 → 進階 → 深入；編號越小越基礎，101 是第一篇。</p>
            </div>
          </li>
          <li>
            <span class="lp-how__n" aria-hidden="true">2</span>
            <div>
              <p class="lp-how__t">看「先讀」</p>
              <p class="lp-how__d">卡片上的「先讀」是建議先讀的文章，不是硬性門檻，看不懂時再回頭補。</p>
            </div>
          </li>
          <li>
            <span class="lp-how__n" aria-hidden="true">3</span>
            <div>
              <p class="lp-how__t">打勾記錄進度</p>
              <p class="lp-how__d">在文章頁按「標記為已讀」，這裡會記住你的進度；紀錄只存在你的瀏覽器。</p>
            </div>
          </li>
        </ol>
      </aside>
    </section>

    {
      paths.length > 0 && (
        <section class="lp-paths" aria-labelledby="lp-paths-title">
          <div class="lp-section-head">
            <h2 class="lp-h2" id="lp-paths-title">
              三條建議路線
            </h2>
            <p class="lp-section-lede">只想弄懂其中一塊？挑一條路線，依序讀完即可；三條路線共用入門的幾篇基礎文章。</p>
          </div>
          <PathCards paths={paths} />
        </section>
      )
    }

    <div class="lp-board">
      <LearnBoard items={items} />
    </div>

    {
      introSources.length > 0 && (
        <div class="lp-sources">
          <SourcesList sources={introSources} />
        </div>
      )
    }
  </div>
</BaseLayout>

<script>
  import { onProgressChange, readSlugs } from '../../client/progress';

  // 「從第一篇開始」 becomes 「繼續閱讀」 at the first unread article (global order) once anything is read.
  const btn = document.querySelector<HTMLAnchorElement>('[data-continue]');
  const label = btn?.querySelector<HTMLElement>('[data-continue-label]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-lb] .lc')];
  const paint = (read: Set<string>) => {
    if (!btn || !label) return;
    const nextCard = cards
      .slice()
      .sort((a, b) => Number(a.dataset['order']) - Number(b.dataset['order']))
      .find((c) => !read.has(c.dataset['slug'] ?? ''));
    const link = nextCard?.querySelector<HTMLAnchorElement>('.lc__link');
    if (read.size > 0 && link) {
      btn.href = link.getAttribute('href') ?? btn.href;
      const name = nextCard?.dataset['short'] ?? '';
      label.textContent = `繼續閱讀：${name}`;
    } else {
      btn.href = btn.dataset['firstHref'] ?? btn.href;
      label.textContent = read.size > 0 ? '從頭複習' : '從第一篇開始';
    }
  };
  paint(readSlugs());
  onProgressChange(paint);
</script>

<style>
  .lp {
    display: grid;
    gap: var(--space-8);
  }
  .lp-head {
    display: grid;
    gap: var(--space-4);
    padding-block-start: var(--space-6);
    max-width: 56rem;
  }
  .lp-head__title {
    font-size: var(--fs-3xl);
    line-height: 1.22;
    text-wrap: balance;
  }
  .lp-nb {
    display: inline-block;
  }
  .lp-head__lede {
    font-size: var(--fs-l);
    line-height: 1.75;
    color: var(--c-fg-muted);
    max-width: var(--measure);
  }
  .lp-stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) 0;
    margin: var(--space-2) 0 0;
  }
  .lp-stats > div {
    --c: var(--c-fg);
    display: grid;
    gap: 0.1em;
    padding-inline: var(--space-5);
    border-inline-start: 1px solid var(--c-border);
  }
  .lp-stats > div:first-child {
    padding-inline-start: 0;
    border-inline-start: 0;
  }
  .lp-stats dt {
    font-size: var(--fs-xs);
    color: var(--c-fg-subtle);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.04em;
  }
  .lp-stats dd {
    margin: 0;
    font-size: var(--fs-s);
    color: var(--c-fg-muted);
    font-variant-numeric: tabular-nums;
  }
  .lp-stats strong {
    font-size: var(--fs-xl);
    color: var(--c);
    margin-inline-end: 0.15em;
  }
  @media (max-width: 479px) {
    .lp-stats > div {
      padding-inline: var(--space-3);
    }
  }
  .lp-head__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-2);
  }
  .lp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: var(--tap);
    max-width: 100%;
    padding: 0 1.25em;
    border: 1px solid var(--c-border-strong);
    border-radius: var(--radius-pill);
    background: var(--c-bg-elev);
    color: var(--c-fg);
    font-weight: var(--fw-semibold);
    text-decoration: none;
    transition:
      background-color var(--dur-1) ease,
      border-color var(--dur-1) ease;
  }
  .lp-btn:hover {
    background: var(--c-hover);
    color: var(--c-fg);
  }
  .lp-btn--primary {
    border-color: var(--c-accent);
    background: var(--c-accent);
    color: var(--c-accent-fg);
  }
  .lp-btn--primary:hover {
    background: color-mix(in srgb, var(--c-accent) 88%, var(--c-fg));
    color: var(--c-accent-fg);
  }
  .lp-btn span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .lp-scene {
    margin-block-start: calc(-1 * var(--space-4));
  }
  .lp-map-alt {
    margin-block-start: var(--space-4);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-l);
    background: var(--c-bg-elev);
  }
  .lp-map-alt__summary {
    display: flex;
    align-items: center;
    gap: 0.5em;
    min-height: var(--tap);
    padding: 0 var(--space-4);
    font-size: var(--fs-s);
    font-weight: var(--fw-semibold);
    color: var(--c-fg-muted);
    cursor: pointer;
    border-radius: inherit;
  }
  .lp-map-alt__summary:hover {
    color: var(--c-fg);
  }
  .lp-map-alt__summary:focus-visible {
    outline: 2px solid var(--c-focus);
    outline-offset: 2px;
  }
  .lp-map-alt__body {
    padding: 0 var(--space-4) var(--space-4);
  }

  .lp-h2 {
    font-size: var(--fs-2xl);
    line-height: 1.3;
  }
  .lp-section-head {
    display: grid;
    gap: var(--space-2);
    margin-block-end: var(--space-5);
  }
  .lp-section-lede {
    color: var(--c-fg-muted);
    max-width: var(--measure);
    line-height: 1.7;
  }

  .lp-intro {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 960px) {
    .lp-intro {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 24rem);
      gap: var(--space-8);
      align-items: start;
    }
  }
  .lp-intro__text {
    display: grid;
    gap: var(--space-4);
    min-width: 0;
  }
  .lp-intro__prose {
    color: var(--c-fg-muted);
  }
  .lp-how {
    padding: var(--space-5);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-l);
    background: var(--c-bg-elev);
  }
  /* the intro text runs much longer than this box: keep it beside the text instead of leaving a gap */
  @media (min-width: 960px) and (min-height: 640px) {
    .lp-how {
      position: sticky;
      inset-block-start: calc(var(--header-h) + var(--space-5));
    }
  }
  .lp-how__list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .lp-how__list li {
    display: flex;
    gap: var(--space-3);
    margin: 0;
  }
  .lp-how__n {
    flex: none;
    display: grid;
    place-items: center;
    inline-size: 1.85rem;
    block-size: 1.85rem;
    border-radius: 50%;
    background: var(--c-accent-soft);
    color: var(--c-accent);
    font-weight: var(--fw-bold);
    font-size: var(--fs-s);
  }
  .lp-how__t {
    font-weight: var(--fw-bold);
    line-height: 1.6;
  }
  .lp-how__d {
    font-size: var(--fs-s);
    color: var(--c-fg-muted);
    line-height: 1.65;
  }

  .lp-board {
    scroll-margin-block-start: calc(var(--header-h) + var(--space-4));
  }
  .lp-board :global(#all-articles) {
    scroll-margin-block-start: calc(var(--header-h) + var(--space-4));
  }
</style>
