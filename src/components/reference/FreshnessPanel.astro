---
/**
 * 「資料新鮮度」: per-collection age distribution of lastVerified (relative to the data date), the
 * entries older than 180 days (flagged, all listed), and a data table behind 「顯示資料表」.
 *   <FreshnessPanel />
 */
import Badge from '../ui/Badge.astro';
import StackBar from './StackBar.astro';
import StaleTable from './StaleTable.astro';
import { AGE_BUCKETS, getFreshness, STALE_DAYS, type AgeBucketId, type FreshnessRow } from './reference-data';

interface Props {
  /** stale entries listed before the rest collapse into 「顯示其餘 N 筆」 */
  limit?: number | undefined;
}
const { limit = 20 } = Astro.props;
const report = await getFreshness(1);
const COLORS: Record<AgeBucketId, string> = {
  fresh: 'var(--c-pos)',
  recent: 'color-mix(in srgb, var(--c-pos) 45%, var(--c-bg-elev))',
  aging: 'var(--c-warn)',
  stale: 'var(--c-neg)',
};
const fmt = (n: number) => n.toLocaleString('zh-TW');
const staleTotal = report.stale.length;
// Every stale entry is listed: the first `limit` in the table, the rest behind a disclosure.
const staleHead: FreshnessRow[] = report.stale.slice(0, limit);
const staleTail: FreshnessRow[] = report.stale.slice(limit);
const oldest = report.oldest[0];
---

<div class="frp" data-pagefind-ignore>
  <p class="frp__summary">
    以資料基準日 <time datetime={report.reference}>{report.reference}</time> 計算，共 <strong class="num">{fmt(report.total)}</strong> 筆附有查核日期的條目，{
      staleTotal > 0 ? (
        <>
          其中 <strong class="num frp__stale-n">{fmt(staleTotal)}</strong> 筆超過 {STALE_DAYS} 天未重新查核，列在下方表格。
        </>
      ) : (
        <>全部都在 {STALE_DAYS} 天內查核過。</>
      )
    }
  </p>

  <ul class="frp__legend" role="list" aria-label="圖例：距上次查核的天數">
    {
      AGE_BUCKETS.map((b) => (
        <li>
          <span class:list={['frp__sw', { 'frp__sw--hatched': b.id === 'stale' }]} style={`--c: ${COLORS[b.id]}`} aria-hidden="true" />
          {b.label}
        </li>
      ))
    }
  </ul>

  <ul class="frp__rows" role="list">
    {
      report.summaries.map((s) => (
        <li class="frp__row">
          <span class="frp__label">{s.label}</span>
          <span class="frp__n num">{s.count ? `${fmt(s.count)} 筆` : '尚無條目'}</span>
          <StackBar
            class="frp__bar"
            label={`${s.label}・距上次查核`}
            parts={AGE_BUCKETS.map((b) => ({ id: b.id, label: b.label, value: s.buckets[b.id], color: COLORS[b.id], hatched: b.id === 'stale' }))}
          />
          <span class="frp__range num">
            {s.oldest && s.newest ? (s.oldest === s.newest ? s.newest : `${s.oldest} 至 ${s.newest}`) : '—'}
          </span>
        </li>
      ))
    }
  </ul>

  <details class="frp__data">
    <summary>顯示資料表</summary>
    <div class="scroll-x">
      <table>
        <caption class="sr-only">各類條目距上次查核的天數分布與查核日期範圍</caption>
        <thead>
          <tr>
            <th scope="col">內容類型</th>
            {AGE_BUCKETS.map((b) => <th scope="col" class="frp__num">{b.label}</th>)}
            <th scope="col" class="frp__num">合計</th>
            <th scope="col">查核日期</th>
          </tr>
        </thead>
        <tbody>
          {
            report.summaries.map((s) => (
              <tr>
                <th scope="row">{s.label}</th>
                {AGE_BUCKETS.map((b) => (
                  <td class:list={['frp__num', { 'frp__flag': b.id === 'stale' && s.buckets.stale > 0 }]}>{fmt(s.buckets[b.id])}</td>
                ))}
                <td class="frp__num">{fmt(s.count)}</td>
                <td>{s.oldest && s.newest ? (s.oldest === s.newest ? s.newest : `${s.oldest} 至 ${s.newest}`) : '—'}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </details>

  <div class="frp__list">
    <h3 class="frp__h">超過 {STALE_DAYS} 天未查核的條目</h3>
    {
      report.total === 0 ? (
        <p class="frp__empty">內容整理中，尚無附查核日期的條目。</p>
      ) : staleTotal === 0 ? (
        <p class="frp__ok">
          <Badge tone="pos">無</Badge>
          <span>
            目前沒有超過 {STALE_DAYS} 天未查核的條目。
            {oldest && (
              <>
                查核日期最早的條目是 <a href={oldest.link.href}>{oldest.link.label}</a>（
                <time datetime={oldest.lastVerified}>{oldest.lastVerified}</time>，{oldest.age > 0 ? `資料基準日前 ${fmt(oldest.age)} 天` : '與資料基準日同一天'}）。
              </>
            )}
          </span>
        </p>
      ) : (
        <>
          <p class="frp__warn">
            <Badge tone="neg">需留意</Badge>
            <span>以下 {fmt(staleTotal)} 筆條目超過 {STALE_DAYS} 天沒有重新查核，數字與敘述可能已經過時，請以來源的最新資料為準。</span>
          </p>
          <StaleTable rows={staleHead} caption={`超過 ${STALE_DAYS} 天未查核的條目`} />
          {staleTail.length > 0 && (
            <details class="frp__more">
              <summary>顯示其餘 {fmt(staleTail.length)} 筆</summary>
              <StaleTable rows={staleTail} caption={`超過 ${STALE_DAYS} 天未查核的條目（續）`} />
            </details>
          )}
        </>
      )
    }
  </div>
</div>

<style>
  @layer components {
    .frp {
      display: grid;
      gap: var(--space-5);
      max-width: 48rem;
    }
    .frp__summary {
      max-width: var(--measure);
      color: var(--c-fg-muted);
    }
    .frp__summary strong {
      color: var(--c-fg);
    }
    .frp__stale-n {
      color: var(--c-neg) !important;
    }
    .frp__legend {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-5);
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: var(--fs-s);
      color: var(--c-fg-muted);
    }
    .frp__legend li {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
    }
    .frp__sw {
      inline-size: 0.85em;
      block-size: 0.85em;
      border-radius: 3px;
      background: var(--c);
    }
    .frp__sw--hatched {
      background: repeating-linear-gradient(135deg, var(--c) 0 2px, color-mix(in srgb, var(--c) 35%, transparent) 2px 5px);
    }
    .frp__rows {
      display: grid;
      gap: var(--space-4);
      margin: 0;
      padding: var(--space-5);
      list-style: none;
      border: 1px solid var(--c-border);
      border-radius: var(--radius-l);
      background: var(--c-bg-elev);
    }
    .frp__row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'label n'
        'bar bar'
        'range range';
      align-items: baseline;
      gap: var(--space-1) var(--space-3);
    }
    @media (min-width: 640px) {
      .frp__row {
        grid-template-columns: 6.5rem 4.5rem minmax(0, 1fr) 13.5rem;
        grid-template-areas: 'label n bar range';
        align-items: center;
      }
    }
    .frp__label {
      grid-area: label;
      font-size: var(--fs-s);
      font-weight: var(--fw-semibold);
    }
    .frp__n {
      grid-area: n;
      font-size: var(--fs-s);
      color: var(--c-fg-muted);
      text-align: end;
    }
    .frp__row :global(.frp__bar) {
      grid-area: bar;
    }
    .frp__range {
      grid-area: range;
      font-size: var(--fs-xs);
      color: var(--c-fg-subtle);
    }
    @media (min-width: 640px) {
      .frp__n {
        text-align: start;
      }
      .frp__range {
        text-align: end;
      }
    }
    .frp__list {
      display: grid;
      gap: var(--space-3);
    }
    .frp__h {
      font-size: var(--fs-l);
    }
    .frp__ok,
    .frp__warn {
      display: flex;
      align-items: baseline;
      gap: var(--space-2);
      font-size: var(--fs-s);
      line-height: 1.75;
      color: var(--c-fg-muted);
    }
    .frp__ok :global(.badge),
    .frp__warn :global(.badge) {
      flex: none;
    }
    .frp__data > summary,
    .frp__more > summary {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap);
      cursor: pointer;
      font-size: var(--fs-s);
      color: var(--c-link);
    }
    .frp__data > summary:hover,
    .frp__more > summary:hover {
      color: var(--c-link-hover);
    }
    .frp__data table {
      display: table;
      inline-size: 100%;
      font-size: var(--fs-s);
      font-variant-numeric: tabular-nums;
    }
    .frp__data th,
    .frp__data td {
      min-width: 0;
      white-space: nowrap;
    }
    .frp__data .frp__num {
      text-align: end;
    }
    .frp__data .frp__flag {
      color: var(--c-neg);
      font-weight: var(--fw-semibold);
    }
    .frp__more {
      display: grid;
      gap: var(--space-2);
    }
    .frp__empty {
      font-size: var(--fs-s);
      color: var(--c-fg-subtle);
    }
  }
</style>
