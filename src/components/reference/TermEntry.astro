---
/**
 * One glossary term block on /glossary/. The anchor id (#hbm) sits on the H3 so Term popovers
 * (「完整解釋 →」 /glossary/#hbm) and Pagefind sub-results land on it.
 *
 *   <TermEntry term={t} />
 *
 * The card shows the title, names and one-line `short`; definition, example, aliases, links and sources
 * sit in a 「完整解釋」 <details data-term-more> (GlossaryFilter opens it for #id deep links and searches;
 * Chrome's find-in-page opens it too). Index-only terms (no src/content/glossary/<id>.yaml yet) render
 * their short info and a calm 「完整解釋整理中」 note. The client filter reads [data-s] elements and data-id to build its search text.
 *
 * Size matters here: /glossary/ lists every term (~300) with its full definition, so the markup is
 * kept lean. No inline SVG, backlinks grouped by page kind (one label per kind, not per link), and the
 * styles below are `is:global` but namespaced under .gl-term: a scoped <style> would stamp a
 * data-astro-cid attribute on every element of every block (~16 KB gz on this page). The CSS is only
 * bundled with pages that render this component.
 */
import Badge from '../ui/Badge.astro';
import { segmentHref } from '../../lib/paths';
import { levelMeta } from '../../lib/collections';
import { PAGE_KIND_LABELS, type GlossaryTermView, type PageKind, type PageLink } from './reference-data';

interface Props {
  term: GlossaryTermView;
  /** Backlinks shown before the rest collapse into 「還有 N 頁」 */
  backlinkLimit?: number | undefined;
  /** Most backlinks listed at all (the rest are counted only), so heavily used terms stay light */
  backlinkMax?: number | undefined;
  /** Most sources listed per term */
  sourceLimit?: number | undefined;
  /**
   * Page-level Pagefind filter and result title, placed inside this block (use on one block per page):
   * the page has no single data-pagefind-body, so the H1 outside the blocks is not seen by Pagefind.
   */
  pagefindPage?: { filter: string; title: string } | undefined;
}
const { term: t, backlinkLimit = 6, backlinkMax = 30, sourceLimit = 3, pagefindPage } = Astro.props;
const lv = levelMeta(t.level);
const aliases = t.aliases.filter((a) => a !== t.term && a !== t.zh && a !== t.en);

/** Backlinks grouped by kind, keeping the (already sorted) order: [[kind, links], …] */
function byKind(links: readonly PageLink[]): Array<[PageKind, PageLink[]]> {
  const out: Array<[PageKind, PageLink[]]> = [];
  for (const l of links) {
    const last = out.at(-1);
    if (last && last[0] === l.kind) last[1].push(l);
    else out.push([l.kind, [l]]);
  }
  return out;
}
const firstLinks = byKind(t.backlinks.slice(0, backlinkLimit));
const moreList = t.backlinks.slice(backlinkLimit, Math.max(backlinkLimit, backlinkMax));
const moreLinks = byKind(moreList);
const unlisted = t.backlinks.length - Math.min(t.backlinks.length, Math.max(backlinkLimit, backlinkMax));
const hasLinks = t.related.length + t.learnMore.length + t.segments.length + t.backlinks.length > 0;
const sources = t.sources.slice(0, sourceLimit);
const hostOf = (u: string) => {
  try {
    return new URL(u).hostname.replace(/^www\./, '');
  } catch {
    return u;
  }
};
const showZh = !!t.zh && t.zh !== t.term;
// The full explanation (definition, example, links, sources) sits behind a disclosure so the page reads
// as a scannable list of one-line summaries first: 由淺入深. Deep links (#hbm) open it (GlossaryFilter).
const hasMore = !!t.definition || !!t.example || aliases.length > 0 || hasLinks || sources.length > 0;
const showEn = !!t.en && t.en !== t.term && t.en !== t.zh;
---

<article class="gl-term" data-term-block data-id={t.id} data-cat={t.category} data-level={t.level} data-pagefind-body style={`--lv:${lv.color}`}>
  {pagefindPage && <span data-pagefind-filter={pagefindPage.filter} data-pagefind-meta={`title:${pagefindPage.title}`} />}
  <header class="gl-term__head">
    <h3 class="gl-term__title" id={t.id} data-pagefind-weight="10" data-s>{t.term}</h3>
    <a class="gl-term__permalink" href={`#${t.id}`} aria-label={`「${t.term}」的連結`} data-pagefind-ignore>#</a>
    <Badge level={t.level} srPrefix="難度：" class="gl-term__level" />
  </header>
  {
    (showZh || showEn) && (
      <p class="gl-term__names" data-s>
        {showZh && <span class="gl-term__zh">{t.zh}</span>}
        {showEn && <span class="gl-term__en" lang="en">{t.en}</span>}
      </p>
    )
  }

  {t.short && <p class="gl-term__short" data-s>{t.short}</p>}

  {
    hasMore ? (
      <details class="gl-term__more" data-term-more>
        <summary class="gl-term__toggle" data-pagefind-ignore>{t.example ? '完整解釋與例子' : '完整解釋'}</summary>
        <div class="gl-term__body">
          {
            t.definition ? (
              <p class="gl-term__def">{t.definition}</p>
            ) : (
              <p class="gl-term__pending" data-pagefind-ignore>完整解釋整理中，先提供簡短說明。</p>
            )
          }

          {
            t.example && (
              <div class="gl-term__example">
                <p class="gl-term__k">舉例來說</p>
                <p>{t.example}</p>
              </div>
            )
          }

          {
            aliases.length > 0 && (
              <p class="gl-term__aliases">
                <span class="gl-term__k">也稱為</span>
                <span data-s>{aliases.join('、')}</span>
              </p>
            )
          }

          {
            hasLinks && (
              <dl class="gl-term__links" data-pagefind-ignore>
                {t.related.length > 0 && (
                  <div>
                    <dt>相關名詞</dt>
                    <dd class="gl-term__chips">
                      {t.related.map((r) => <a class="gl-chip" href={r.href}>{r.label}</a>)}
                    </dd>
                  </div>
                )}
                {t.learnMore.length > 0 && (
                  <div>
                    <dt>延伸閱讀</dt>
                    <dd class="gl-term__learn">
                      {t.learnMore.map((l) => <a href={l.href}>{l.label}</a>)}
                    </dd>
                  </div>
                )}
                {t.segments.length > 0 && (
                  <div>
                    <dt>相關環節</dt>
                    <dd class="gl-term__chips">
                      {t.segments.map((s) => (
                        <a class="gl-chip gl-chip--seg" href={segmentHref(s.id)} style={`--seg:${s.color}`}>{s.short}</a>
                      ))}
                    </dd>
                  </div>
                )}
                {t.backlinks.length > 0 && (
                  <div>
                    <dt>出現在…</dt>
                    <dd class="gl-back">
                      {firstLinks.map(([kind, links]) => (
                        <p><b>{PAGE_KIND_LABELS[kind]}</b>{links.map((b) => <a href={b.href}>{b.label}</a>)}</p>
                      ))}
                      {moreLinks.length > 0 && (
                        <details>
                          <summary>還有 {moreList.length + unlisted} 頁</summary>
                          {moreLinks.map(([kind, links]) => (
                            <p><b>{PAGE_KIND_LABELS[kind]}</b>{links.map((b) => <a href={b.href}>{b.label}</a>)}</p>
                          ))}
                          {unlisted > 0 && <p class="gl-back__note">另有 {unlisted} 頁提及，未逐一列出。</p>}
                        </details>
                      )}
                    </dd>
                  </div>
                )}
              </dl>
            )
          }

          {
            sources.length > 0 && (
              <p class="gl-term__sources" data-pagefind-ignore>
                <span class="gl-term__k">來源</span>
                {sources.map((s) => <a href={s.url}>{s.publisher || hostOf(s.url)}</a>)}
              </p>
            )
          }
        </div>
      </details>
    ) : (
      <p class="gl-term__pending" data-pagefind-ignore>完整解釋整理中。</p>
    )
  }
</article>

<style is:global>
  /* Namespaced under .gl-term (see the note at the top of this file). */
  @layer components {
    .gl-term {
      position: relative;
      display: grid;
      gap: var(--space-3);
      padding: var(--space-5) var(--space-5) var(--space-5) calc(var(--space-5) + 2px);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-l);
      background: var(--c-bg-elev);
      box-shadow: var(--shadow-1);
      min-width: 0;
      transition:
        border-color var(--dur-2) ease,
        box-shadow var(--dur-2) ease;
    }
    .gl-term::before {
      content: '';
      position: absolute;
      inset-block: var(--space-5);
      inset-inline-start: -1px;
      inline-size: 3px;
      border-radius: 0 3px 3px 0;
      background: var(--lv);
    }
    .gl-term:has(.gl-term__title:target) {
      border-color: var(--c-accent);
      box-shadow:
        0 0 0 3px color-mix(in srgb, var(--c-accent) 22%, transparent),
        var(--shadow-2);
    }

    .gl-term__head {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2);
    }
    .gl-term__title {
      font-size: var(--fs-xl);
      line-height: 1.3;
      letter-spacing: 0.005em;
      margin: 0;
      overflow-wrap: anywhere;
      scroll-margin-top: var(--space-6); /* on top of html scroll-padding-top (header) */
    }
    .gl-term__permalink {
      display: inline-grid;
      place-items: center;
      inline-size: 2rem;
      block-size: 2rem;
      border-radius: var(--radius-m);
      color: var(--c-fg-subtle);
      font-size: var(--fs-l);
      font-weight: var(--fw-semibold);
      text-decoration: none;
      opacity: 0;
      transition:
        opacity var(--dur-1) ease,
        background-color var(--dur-1) ease;
    }
    .gl-term:hover .gl-term__permalink,
    .gl-term:has(.gl-term__title:target) .gl-term__permalink,
    .gl-term .gl-term__permalink:focus-visible {
      opacity: 1;
    }
    @media (hover: none) {
      .gl-term .gl-term__permalink {
        opacity: 0.6;
      }
    }
    .gl-term .gl-term__permalink:hover {
      background: var(--c-hover);
      color: var(--c-link);
    }
    .gl-term__head .gl-term__level {
      margin-inline-start: auto;
    }
    .gl-term .gl-term__names {
      display: flex;
      flex-wrap: wrap;
      gap: 0.15em 0.9em;
      margin-block-start: calc(-1 * var(--space-2));
      font-size: var(--fs-s);
      line-height: 1.6;
      color: var(--c-fg-muted);
    }
    .gl-term__zh {
      font-weight: var(--fw-semibold);
      color: var(--c-fg);
    }
    .gl-term__en {
      color: var(--c-fg-subtle);
    }
    .gl-term__short {
      font-size: var(--fs-m);
      font-weight: var(--fw-medium);
      line-height: 1.75;
      color: var(--c-fg);
      max-width: var(--measure);
    }
    .gl-term__def {
      font-size: var(--fs-m);
      line-height: var(--lh-body);
      color: var(--c-fg-muted);
      max-width: var(--measure);
    }
    .gl-term__pending {
      font-size: var(--fs-s);
      color: var(--c-fg-subtle);
    }

    /* 「完整解釋」 disclosure: closed, the card is title + names + one-line summary */
    .gl-term__more {
      min-width: 0;
    }
    .gl-term .gl-term__toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.55em;
      min-height: var(--tap);
      margin-block: calc(-1 * var(--space-2)) calc(-1 * var(--space-3));
      padding-inline-end: 0.25em;
      border-radius: var(--radius-s);
      color: var(--c-link);
      font-size: var(--fs-s);
      font-weight: var(--fw-semibold);
      cursor: pointer;
      list-style: none;
      inline-size: fit-content;
      user-select: none;
    }
    .gl-term__toggle::-webkit-details-marker {
      display: none;
    }
    .gl-term__toggle::after {
      content: '';
      inline-size: 0.45em;
      block-size: 0.45em;
      margin-block-start: -0.2em;
      border-inline-end: 2px solid currentColor;
      border-block-end: 2px solid currentColor;
      transform: rotate(45deg);
      transition: transform var(--dur-2) var(--ease-out);
    }
    .gl-term__more[open] > .gl-term__toggle::after {
      margin-block-start: 0.25em;
      transform: rotate(-135deg);
    }
    .gl-term .gl-term__toggle:hover {
      color: var(--c-link-hover);
    }
    .gl-term__more[open] > .gl-term__toggle {
      margin-block-end: var(--space-1);
    }
    .gl-term__body {
      display: grid;
      gap: var(--space-3);
      min-width: 0;
      padding-block-start: var(--space-3);
      border-block-start: 1px solid var(--c-border);
    }
    .gl-term__pending::before {
      content: '';
      display: inline-block;
      inline-size: 0.55em;
      block-size: 0.55em;
      margin-inline-end: 0.5em;
      border-radius: 50%;
      border: 1.5px dashed currentColor;
      vertical-align: 0.05em;
    }
    .gl-term__example {
      display: grid;
      gap: var(--space-1);
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-m);
      background: var(--c-bg-sunken);
      font-size: var(--fs-s);
      line-height: 1.8;
      color: var(--c-fg-muted);
      max-width: var(--measure);
    }
    .gl-term__aliases {
      font-size: var(--fs-s);
      color: var(--c-fg-muted);
      line-height: 1.7;
    }
    .gl-term .gl-term__k {
      display: inline-block;
      margin-inline-end: 0.6em;
      font-size: var(--fs-xs);
      font-weight: var(--fw-semibold);
      letter-spacing: var(--tracking-wide);
      color: var(--c-fg-subtle);
    }

    .gl-term__links {
      display: grid;
      gap: var(--space-3);
      margin: var(--space-1) 0 0;
      padding-block-start: var(--space-4);
      border-block-start: 1px dashed var(--c-border);
    }
    .gl-term__links > div {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-1);
    }
    @media (min-width: 640px) {
      .gl-term__links > div {
        grid-template-columns: 5.5em minmax(0, 1fr);
        gap: var(--space-3);
        align-items: baseline;
      }
    }
    .gl-term__links dt {
      font-size: var(--fs-xs);
      font-weight: var(--fw-semibold);
      letter-spacing: var(--tracking-wide);
      color: var(--c-fg-subtle);
      line-height: 2.2;
    }
    .gl-term__links dd {
      margin: 0;
      min-width: 0;
    }
    .gl-term__chips {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .gl-term .gl-chip {
      display: inline-flex;
      align-items: center;
      gap: 0.45em;
      min-height: 2rem;
      padding: 0.1em 0.8em;
      border-radius: var(--radius-pill);
      border: 1px solid var(--c-border);
      background: var(--c-bg);
      color: var(--c-fg);
      font-size: var(--fs-s);
      line-height: 1.4;
      text-decoration: none;
      transition:
        border-color var(--dur-1) ease,
        background-color var(--dur-1) ease;
    }
    .gl-term .gl-chip:hover {
      border-color: var(--c-accent);
      background: var(--c-accent-soft);
      color: var(--c-fg);
    }
    .gl-term .gl-chip--seg::before {
      content: '';
      inline-size: 0.6em;
      block-size: 0.6em;
      border-radius: 50%;
      background: var(--seg);
      flex: none;
    }
    .gl-term__learn {
      display: grid;
      justify-items: start;
      gap: var(--space-1);
      font-size: var(--fs-s);
      line-height: 1.8;
    }
    .gl-term__learn a::after {
      content: ' →';
    }

    /* 出現在…: one line per page kind, links separated by 「、」 */
    .gl-term .gl-back {
      display: grid;
      gap: 0.15em;
      font-size: var(--fs-s);
      line-height: 1.9;
    }
    .gl-back p {
      max-width: none;
    }
    .gl-back b {
      display: inline-block;
      margin-inline-end: 0.5em;
      padding: 0 0.45em;
      border-radius: var(--radius-s);
      background: var(--c-bg-sunken);
      font-size: var(--fs-xs);
      font-weight: var(--fw-semibold);
      line-height: 1.7;
      color: var(--c-fg-subtle);
      vertical-align: 0.08em;
    }
    .gl-back a + a::before {
      content: '、';
      display: inline-block;
      color: var(--c-fg-subtle);
      text-decoration: none;
    }
    .gl-back details {
      display: grid;
      gap: 0.15em;
    }
    .gl-back summary {
      display: inline-flex;
      align-items: center;
      min-height: var(--tap);
      cursor: pointer;
      color: var(--c-link);
      inline-size: fit-content;
    }
    .gl-back summary:hover {
      color: var(--c-link-hover);
    }
    .gl-back .gl-back__note {
      font-size: var(--fs-xs);
      color: var(--c-fg-subtle);
    }

    .gl-term__sources {
      font-size: var(--fs-xs);
      line-height: 1.8;
      color: var(--c-fg-subtle);
    }
    .gl-term__sources a {
      color: var(--c-fg-muted);
    }
    .gl-term__sources a + a::before {
      content: '・';
      color: var(--c-fg-subtle);
      display: inline-block;
      text-decoration: none;
    }
    .gl-term__sources a:hover {
      color: var(--c-link-hover);
    }

    @media (max-width: 479px) {
      .gl-term {
        padding: var(--space-4) var(--space-4) var(--space-4) calc(var(--space-4) + 2px);
      }
      .gl-term::before {
        inset-block: var(--space-4);
      }
    }
  }
</style>
