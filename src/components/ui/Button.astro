---
/**
 * Button or button-styled link (with `href`). Minimum 44px touch target.
 *
 *   <Button href={sectionHref('learn')} variant="primary">開始學習</Button>
 *   <Button type="button" variant="ghost" icon="arrow-right" iconPosition="end">下一步</Button>
 */
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  href?: string | undefined;
  variant?: 'primary' | 'secondary' | 'ghost' | undefined;
  size?: 's' | 'm' | undefined;
  type?: 'button' | 'submit' | 'reset' | undefined;
  icon?: IconName | undefined;
  iconPosition?: 'start' | 'end' | undefined;
  disabled?: boolean | undefined;
  class?: string | undefined;
  id?: string | undefined;
  'aria-label'?: string | undefined;
  'aria-controls'?: string | undefined;
  'aria-expanded'?: 'true' | 'false' | undefined;
  [key: `data-${string}`]: string | undefined;
}

const {
  href,
  variant = 'secondary',
  size = 'm',
  type = 'button',
  icon,
  iconPosition = 'start',
  disabled = false,
  class: className,
  ...rest
} = Astro.props;
const cls = ['btn', `btn--${variant}`, `btn--${size}`, className];
---

{
  href ? (
    <a href={href} class:list={cls} {...rest}>
      {icon && iconPosition === 'start' && <Icon name={icon} />}
      <span>
        <slot />
      </span>
      {icon && iconPosition === 'end' && <Icon name={icon} />}
    </a>
  ) : (
    <button type={type} class:list={cls} disabled={disabled} {...rest}>
      {icon && iconPosition === 'start' && <Icon name={icon} />}
      <span>
        <slot />
      </span>
      {icon && iconPosition === 'end' && <Icon name={icon} />}
    </button>
  )
}

<style>
  @layer components {
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5em;
      min-height: var(--tap);
      padding: 0.5em 1.15em;
      border-radius: var(--radius-m);
      border: 1px solid transparent;
      font-size: var(--fs-s);
      font-weight: var(--fw-semibold);
      line-height: 1.3;
      text-decoration: none;
      white-space: nowrap;
      transition:
        background-color var(--dur-1) ease,
        border-color var(--dur-1) ease,
        color var(--dur-1) ease;
    }
    .btn--s {
      min-height: 2.25rem;
      padding: 0.3em 0.85em;
      font-size: var(--fs-xs);
    }
    .btn--primary {
      background: var(--c-accent);
      color: var(--c-accent-fg);
    }
    .btn--primary:hover {
      background: color-mix(in srgb, var(--c-accent) 86%, var(--c-fg));
      color: var(--c-accent-fg);
    }
    .btn--secondary {
      background: var(--c-bg-elev);
      border-color: var(--c-border-strong);
      color: var(--c-fg);
    }
    .btn--secondary:hover {
      background: var(--c-hover);
      color: var(--c-fg);
    }
    .btn--ghost {
      background: transparent;
      color: var(--c-fg);
    }
    .btn--ghost:hover {
      background: var(--c-hover);
      color: var(--c-fg);
    }
    .btn:disabled {
      opacity: 0.55;
    }
  }
</style>
