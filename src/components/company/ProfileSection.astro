---
/**
 * A titled section of a company profile with consistent rhythm (owner: pages-companies).
 *
 *   <ProfileSection id="products" title="產品" lede="…">…</ProfileSection>
 */
interface Props {
  id: string;
  title: string;
  lede?: string | undefined;
  /** small text after the title (e.g. a count) */
  aside?: string | undefined;
  class?: string | undefined;
}
const { id, title, lede, aside, class: className } = Astro.props;
---

<section class:list={['psec', className]} id={id} aria-labelledby={`${id}-title`}>
  <header class="psec__head">
    <h2 class="psec__title" id={`${id}-title`}>
      {title}
      {aside && <span class="psec__aside">{aside}</span>}
    </h2>
    {lede && <p class="psec__lede">{lede}</p>}
    <slot name="head" />
  </header>
  <slot />
</section>

<style>
  .psec {
    scroll-margin-top: calc(var(--header-h, 4rem) + var(--space-4));
    padding-block: var(--space-6);
    border-block-start: 1px solid var(--c-border);
  }
  .psec:first-child {
    padding-block-start: 0;
    border-block-start: 0;
  }
  .psec__head {
    display: grid;
    gap: var(--space-2);
    margin-block-end: var(--space-4);
  }
  .psec__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.6em;
    font-size: var(--fs-xl);
    line-height: 1.3;
  }
  .psec__aside {
    font-size: var(--fs-s);
    font-weight: var(--fw-regular);
    color: var(--c-fg-subtle);
    font-variant-numeric: tabular-nums;
  }
  .psec__lede {
    max-width: var(--measure);
    font-size: var(--fs-s);
    line-height: 1.75;
    color: var(--c-fg-muted);
  }
</style>
