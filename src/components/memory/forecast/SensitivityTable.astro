---
/**
 * Sensitivities: what happens to the base forecast when one driver moves (driver, change, effect).
 *   <SensitivityTable b={bundle} />
 */
import FcText from './FcText.astro';
import type { FcBundle } from '../../../lib/forecast-data';

interface Props {
  b: FcBundle;
}
const { b } = Astro.props;
const rows = b.model.sensitivities;
---

{
  rows.length > 0 && (
    <div class="mem-tablewrap mem-tablewrap--cards fc-sens" tabindex="0" role="region" aria-label="敏感度分析">
      <table class="mem-table">
        <caption class="ch-sr">敏感度分析：只改變一項假設、其餘維持基準情境</caption>
        <thead>
          <tr>
            <th scope="col">驅動因素</th>
            <th scope="col">變動</th>
            <th scope="col">對預測的影響</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr>
              <th scope="row" data-label="驅動因素">
                {r.driver}
              </th>
              <td data-label="變動">{r.change}</td>
              <td data-label="影響">
                <FcText b={b} text={r.effect} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
