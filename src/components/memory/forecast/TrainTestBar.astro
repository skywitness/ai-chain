---
/**
 * Training, test and forecast windows of a model as one proportional strip (one cell per quarter span).
 *   <TrainTestBar b={bundle} />
 */
import { forecastQuarters, periodLabel, qIndex, scenarioOf, type FcBundle } from '../../../lib/forecast-data';

interface Props {
  b: FcBundle;
}
const { b } = Astro.props;
const { model: m } = b;
const fq = forecastQuarters(scenarioOf(m, 'base'));
const span = (from: string, to: string) => Math.max(1, qIndex(to) - qIndex(from) + 1);
const parts = [
  { k: 'train', label: '訓練期', hint: '估計參數', from: m.train.from, to: m.train.to },
  { k: 'test', label: '回測期', hint: '逐季預測、與實際比較', from: m.test.from, to: m.test.to },
  ...(fq.length ? [{ k: 'fc', label: '預測期', hint: '三種情境', from: fq[0]!.period, to: fq.at(-1)!.period }] : []),
].map((p) => ({ ...p, n: span(p.from, p.to) }));
---

<figure class="fc-win" aria-label="模型的訓練期、回測期與預測期">
  <ol class="fc-win__bar" role="list">
    {
      parts.map((p) => (
        <li class:list={['fc-win__seg', `fc-win__seg--${p.k}`]} style={`--n:${p.n}`}>
          <span class="fc-win__label">{p.label}</span>
          <span class="fc-win__range">
            {periodLabel(p.from)}–{periodLabel(p.to)}
          </span>
          <span class="fc-win__hint">
            {p.n} 季 · {p.hint}
          </span>
        </li>
      ))
    }
  </ol>
  <figcaption class="mem-fine">
    參數只用訓練期的資料估計。回測期的每一季，只用上一季以前的財報，加上當季實際的合約價{b.company === 'micron' ? '與美光公布的位元出貨' : '與月營收'}來預測，再和實際財報比較，衡量的是「價格已知時」模型拆解財報的能力。預測期的參數改用到最新一季為止的資料重新估計。
  </figcaption>
</figure>
