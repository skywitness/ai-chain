---
/**
 * Link cards to the financial-model pages, with the model's headline from its data:
 *   <ForecastLinks />                                   → the memory-topic cards (section 「財報模型：群聯與美光」 on /memory/)
 *   <ForecastLinks companies={['tsmc', 'spacex']} />     → cards of the given companies
 *   <ForecastLinks variant="callout" company="micron" /> → one card on /companies/<id>/ (every company with a page)
 * A company whose forecast files are missing is left out (renders nothing when none is available).
 */
import './forecast-links.css';
import Icon from '../../ui/Icon.astro';
import {
  FC_META,
  calendarHint,
  fcPct,
  forecastCompaniesWithPages,
  forecastHref,
  forecastOf,
  forecastQuarters,
  getForecastData,
  periodLabel,
  scenarioOf,
  selectedCandidate,
  type FcCompany,
} from '../../../lib/forecast-data';
import { errHeadline } from './fc-labels';
import { uid } from '../../content/page-state';
import { sectionHref } from '../../../lib/paths';
import { zhConcat } from '../../../lib/format';

interface Props {
  variant?: 'cards' | 'callout' | undefined;
  company?: FcCompany | undefined;
  companies?: readonly FcCompany[] | undefined;
  class?: string | undefined;
}
const { variant = 'cards', company, companies, class: className } = Astro.props;
const HEAD_LABEL = { revenue: '營收', grossMargin: '毛利率', eps: 'EPS' } as const;
const list = (company ? [company] : (companies ?? forecastCompaniesWithPages('memory'))).flatMap((c) => {
  const b = getForecastData(c);
  if (!b) return [];
  const m = b.model;
  const sel = selectedCandidate(m);
  const fq = forecastQuarters(scenarioOf(m, 'base'));
  const firstQ = fq[0];
  const year = scenarioOf(m, 'base')?.forecasts.filter((f) => !/Q/.test(f.period)).at(-1);
  // 「營收平均誤差 4.1%、毛利率 1.2 個百分點」 (群聯: 毛利率 only)
  const err = (b.meta.headline ?? ['revenue', 'grossMargin'])
    .filter((t) => sel.metrics[t])
    .map((t, i) => `${HEAD_LABEL[t]}${i === 0 ? `${t === 'eps' ? ' ' : ''}平均誤差` : ''} ${errHeadline(b, t, sel.metrics[t])}`)
    .join('、');
  // fiscal years (美光 9, 輝達 2): 「FY 是美光的會計年度：FY2027 Q1 約為 2026 年 9–11 月，FY2027 約為 2026 年 9 月至 2027 年 8 月。」
  const fy = b.meta.fyStartMonth;
  const cal = (p: string) => `${periodLabel(p)} 約為 ${calendarHint(p, fy).replace(/^約 /, '')}`;
  const fyNote = fy
    ? `${zhConcat('FY 是', b.meta.name, '的會計年度：')}${[firstQ?.period, year?.period]
        .filter((p): p is string => !!p && p.startsWith('FY'))
        .map(cal)
        .join('，')}。`
    : '';
  return [
    {
      c,
      meta: FC_META[c],
      href: forecastHref(c),
      sel: sel.name,
      err,
      test: `${periodLabel(m.test.from)}–${periodLabel(m.test.to)}`,
      gm: [
        firstQ ? { p: periodLabel(firstQ.period), v: fcPct(forecastOf(m, 'base', firstQ.period)?.grossMargin) } : null,
        year ? { p: periodLabel(year.period), v: fcPct(year.grossMargin) } : null,
      ].filter((x): x is { p: string; v: string } => !!x),
      blurb: FC_META[c].blurb,
      fyNote: /約為/.test(fyNote) ? fyNote : '',
    },
  ];
});
// callout kicker: the topic the page belongs to
const topic = list[0]?.meta.topic ?? 'memory';
const hid = uid(Astro, 'fc-links');
// what the models are built from: the memory topic's price paths, or the page's own inputs (FC_META.noticeInputs) on a
// /forecast/ company callout — 「假設價格路徑」 does not describe 台積電、輝達… models
const footInputs =
  topic === 'memory' ? '依公開資料與假設價格路徑' : list.length === 1 ? `依${list[0]!.meta.noticeInputs}` : '依公開財報、驅動因子與假設的情境';
---

{
  list.length > 0 && (
    <div class:list={['fc-links', `fc-links--${variant}`, className]} data-pagefind-ignore>
      {variant === 'callout' && (
        <p class="fc-links__kicker" id={hid}>
          <span class="mem-head__badge">財報模型</span>
          {topic === 'memory' ? '記憶體與儲存專題' : <a href={sectionHref('forecast')}>財報模型專題</a>}
        </p>
      )}
      <ul class="fc-links__list" role="list" aria-labelledby={variant === 'callout' ? hid : undefined}>
        {list.map((x) => (
          <li class="fc-link" style={x.meta.topic === 'memory' ? undefined : `--fc-seg: var(--seg-${x.meta.segment})`}>
            <p class="fc-link__title">
              <a href={x.href}>{x.meta.h1}</a>
            </p>
            <p class="fc-link__desc">{x.blurb}</p>
            <dl class="fc-link__facts">
              <div>
                <dt>選定模型</dt>
                <dd>
                  {x.sel}
                  <small>
                    回測 {x.test}：{x.err}
                  </small>
                </dd>
              </div>
              <div>
                <dt>
                  {x.meta.gmLabel}
                  <span class="mem-st mem-st--forecast">基準情境</span>
                </dt>
                <dd class="fc-link__gm">
                  {x.gm.map((g, i) => (
                    <>
                      {i > 0 && <Icon name="arrow-right" size="0.9em" />}
                      <span>
                        <small>{g.p}</small>
                        <b>{g.v}</b>
                      </span>
                    </>
                  ))}
                </dd>
              </div>
            </dl>
            {x.fyNote && <p class="fc-link__fy">{x.fyNote}</p>}
            <a class="fc-link__cta" href={x.href}>
              {zhConcat('看', x.meta.name, '的模型、回測與情境')}
              <Icon name="arrow-right" />
            </a>
          </li>
        ))}
      </ul>
      <p class="mem-fine fc-links__foot">
        <Icon name="info" size="1em" />
        {footInputs}推算的教學模型，不是投資建議；不提供目標價或買賣建議。
      </p>
    </div>
  )
}
