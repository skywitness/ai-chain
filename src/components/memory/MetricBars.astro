---
/**
 * Horizontal bars for the memory data, built on ChartFrame (title, unit, notes, sources, 「顯示資料表」).
 * Every bar carries its value; estimates are hatched and forecasts outlined with a dashed border, and both are
 * written out next to the value. Several series render as grouped bars (one row per period).
 *
 *   <MetricBars title="HBM 佔晶圓投片與位元供給比重" unit="%" series={[{ name, points: [{ label, value, status, src }] }]} />
 */
import './memory.css';
import ChartFrame from '../charts/ChartFrame.astro';
import { pageSources, resolveSources } from '../charts/sources';
import { pct, round, tip, vars } from '../charts/chart-utils';
import type { LegendItem, TableSpec } from '../charts/types';
import { STATUS_LABEL, plainText, type DataStatus, type MetricSeries } from '../../lib/memory-data';
import { displayUnit, fmtValue } from './memory-format';

interface Props {
  title: string;
  unit: string;
  series: MetricSeries[];
  subtitle?: string | undefined;
  notes?: Array<string | null | undefined> | undefined;
  /** series colours (default: the given accent for one series, chart slots for several) */
  colors?: string[] | undefined;
  accent?: string | undefined;
  asOf?: string | undefined;
  as?: 'h3' | 'h4' | 'h5' | 'p' | undefined;
  /** extra source keys (e.g. cited in a note) */
  extraSources?: string[] | undefined;
  class?: string | undefined;
}
const { title, unit: rawUnit, series: rawSeries, subtitle, notes = [], colors, accent = 'var(--chart-1)', asOf, as = 'h4', extraSources = [], class: className } = Astro.props;

const { unit, factor } = displayUnit(rawUnit);
const series = rawSeries.map((s) => ({ ...s, points: s.points.map((p) => ({ ...p, value: p.value * factor })) }));
const multi = series.length > 1;
const color = (i: number) => colors?.[i] ?? (multi ? `var(--chart-${i + 1})` : accent);

// rows: labels in the order of the first series, then any label only later series have
const labels: Array<{ label: string; sub?: string | undefined }> = [];
for (const s of series) for (const p of s.points) if (!labels.some((l) => l.label === p.label && l.sub === p.sub)) labels.push({ label: p.label, sub: p.sub });
const at = (si: number, l: { label: string; sub?: string | undefined }) => series[si]!.points.find((p) => p.label === l.label && p.sub === l.sub);

const vals = series.flatMap((s) => s.points.map((p) => p.value));
const lo = Math.min(0, ...vals);
const hi = Math.max(0, ...vals);
const domain: [number, number] = [lo, hi === lo ? lo + 1 : hi];
const zero = pct(0, domain);
const fmt = (v: number) => fmtValue(v, unit);

const statuses = new Set<DataStatus>(series.flatMap((s) => s.points.map((p) => p.status)));
const legend: LegendItem[] = multi ? series.map((s, i) => ({ label: s.name, kind: 'bar', color: color(i) })) : [];

const keys = [...new Set([...series.flatMap((s) => s.points.map((p) => p.src)), ...extraSources])];
const sources = resolveSources(keys, pageSources(Astro));

const aria =
  `${title}長條圖（單位：${unit}）。` +
  labels
    .slice(0, 10)
    .map((l) => {
      const parts = series.map((s, i) => {
        const p = at(i, l);
        return p ? `${multi ? `${s.name} ` : ''}${fmt(p.value)}${p.status !== 'actual' ? `（${STATUS_LABEL[p.status]}）` : ''}` : '';
      });
      return `${l.label}${l.sub ? `（${l.sub}）` : ''}：${parts.filter(Boolean).join('、')}`;
    })
    .join('；') +
  (labels.length > 10 ? '等。' : '。');

const table: TableSpec = multi
  ? {
      columns: [{ key: 'l', label: '期間' }, ...series.map((s, i) => ({ key: `s${i}`, label: s.name, numeric: true }))],
      rows: labels.map((l) => {
        const row: Record<string, string> = { l: l.sub ? `${l.label}（${l.sub}）` : l.label };
        series.forEach((_, i) => {
          const p = at(i, l);
          row[`s${i}`] = p ? `${fmt(p.value)}${p.status !== 'actual' ? `（${STATUS_LABEL[p.status]}）` : ''}` : '';
        });
        return row;
      }),
    }
  : {
      columns: [
        { key: 'l', label: '項目' },
        { key: 'v', label: `數值（${unit}）`, numeric: true },
        { key: 's', label: '狀態' },
        { key: 'n', label: '附註' },
      ],
      rows: (series[0]?.points ?? []).map((p) => ({
        l: p.sub ? `${p.label}（${p.sub}）` : p.label,
        v: fmt(p.value),
        s: STATUS_LABEL[p.status],
        n: plainText(p.note),
      })),
    };
---

<ChartFrame
  title={title}
  as={as}
  subtitle={subtitle}
  unit={unit}
  asOf={asOf}
  legend={legend}
  notes={notes}
  sources={sources}
  table={table}
  empty={labels.length === 0}
  class={['mem-chart', className].filter(Boolean).join(' ')}
>
  {
    (statuses.has('estimate') || statuses.has('forecast')) && (
      <p class="mem-legend mem-legend--inline" aria-hidden="true">
        {statuses.has('actual') && (
          <span class="mem-legend__item">
            <i class="mem-legend__sw" style={`--k: ${multi ? 'var(--c-fg-muted)' : accent}`} />
            實際
          </span>
        )}
        {statuses.has('estimate') && (
          <span class="mem-legend__item">
            <i class="mem-legend__sw mem-legend__sw--estimate" style={`--k: ${multi ? 'var(--c-fg-muted)' : accent}`} />
            估計
          </span>
        )}
        {statuses.has('forecast') && (
          <span class="mem-legend__item">
            <i class="mem-legend__sw mem-legend__sw--forecast" style={`--k: ${multi ? 'var(--c-fg-muted)' : accent}`} />
            預測
          </span>
        )}
      </p>
    )
  }
  <div class:list={['mem-mb', multi && 'mem-mb--multi']} role="img" aria-label={aria}>
    {
      labels.map((l) => (
        <div class="mem-mb__row">
          <span class="mem-mb__label" aria-hidden="true">
            {l.label}
            {l.sub && <small>{l.sub}</small>}
          </span>
          <span class="mem-mb__bars" aria-hidden="true">
            {series.map((s, i) => {
              const p = at(i, l);
              if (!p) return <span class="mem-mb__track mem-mb__track--empty" />;
              const v = pct(p.value, domain);
              const neg = p.value < 0;
              return (
                <span
                  class="mem-mb__track"
                  data-tip={tip(`${l.label}${l.sub ? `（${l.sub}）` : ''}${multi ? `・${s.name}` : ''}`, [
                    [unit === '%' ? '數值' : unit, fmt(p.value)],
                    p.status !== 'actual' ? ['狀態', STATUS_LABEL[p.status]] : null,
                    p.note ? ['附註', plainText(p.note)] : null,
                  ])}
                >
                  {zero > 0 && <i class="mem-mb__zero" style={`--x: ${zero}%`} />}
                  <span
                    class:list={['mem-mb__bar', `mem-mb__bar--${p.status}`]}
                    style={vars({ '--k': color(i), '--l': `${neg ? v : zero}%`, '--w': `${round(Math.max(0.6, Math.abs(v - zero)), 3)}%` })}
                  />
                  <span class="mem-mb__val" style={vars({ '--x': `${neg ? zero : v}%` })}>
                    {fmt(p.value)}
                    {p.status !== 'actual' && <small>{STATUS_LABEL[p.status]}</small>}
                  </span>
                </span>
              );
            })}
          </span>
        </div>
      ))
    }
  </div>
</ChartFrame>
