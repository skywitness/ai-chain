---
/**
 * 驅動因子（輝達）: the charts behind the model — the five hyperscalers' capex against NVIDIA's data-center revenue
 * (calendar quarters, the fiscal quarter about one month later on the same point) and the ratio the selected model
 * uses; the five companies' capex and the annual totals with the base scenario; customers (hyperscale, ACIE, edge)
 * and compute vs networking; the GAAP and core gross margin with the guidance midpoint, the provisions and the
 * memory contract-price index; supply commitments and CoWoS capacity (outside estimates); China. Driver points come
 * from nvidia-drivers.yaml, reported figures from nvidia-inputs.yaml, the ratios, paths and forecasts from
 * nvidia-model.json (forecast points dashed or hatched). The generic tables of every driver series follow in a closed
 * disclosure (src/pages/forecast/[company].astro).
 *   <Drivers b={bundle} />
 */
import MultiLine from '../../charts/MultiLine.astro';
import QuarterBars from '../../memory/forecast/QuarterBars.astro';
import ChartCites from '../../memory/forecast/ChartCites.astro';
import FcCite from '../../memory/forecast/FcCite.astro';
import FcText from '../../memory/forecast/FcText.astro';
import StatusTag from '../../memory/StatusTag.astro';
import Icon from '../../ui/Icon.astro';
import {
  actualGrossMargin,
  chartKey,
  citesIn,
  derivedOf,
  driverOf,
  fcPct,
  forecastQuarters,
  lastReportedOf,
  nextQuarter,
  periodLabel,
  qIndex,
  quarterOf,
  scenarioOf,
  type FcBundle,
} from '../../../lib/forecast-data';
import { formatDate, formatMoney, formatNumber } from '../../../lib/format';
import {
  CAPEX_COMPANIES,
  assumptionNum,
  assumptionOf,
  calOf,
  calQuarters,
  capexPath,
  capexYears,
  derivedMap,
  driverMap,
  driverPts,
  extraOf,
  newClassFrom,
  noteKey,
  param,
  platformRows,
  provisionBasis,
  shownQuarters,
  weeksOf,
} from './nv-data';

interface Props {
  b: FcBundle;
}
const { b } = Astro.props;
const { inputs, model: m, meta } = b;
const from = meta.historyFrom;
const last = lastReportedOf(m);
const lastQ = quarterOf(inputs, last)!;
const next = nextQuarter(last);
const base = forecastQuarters(scenarioOf(m, 'base'));
const fLast = base.at(-1)?.period ?? last;
const qs = shownQuarters(b);
const n0 = (v: number) => formatNumber(v, { digits: 0 });
const n1 = (v: number) => formatNumber(v, { digits: 1 });
/** assumption numbers as written (「30%」「62.5%」) */
const t1 = (v: number) => formatNumber(v, { digits: 1, trim: true });
const yi = (v: number | null | undefined) => (v == null ? null : v / 100);
const usd = (v: number) => formatMoney(v, 'USD', { unit: v >= 1e6 ? '兆' : '億' });
const se = (note: string | undefined) => {
  const x = /標準誤 ([\d.]+)/.exec(note ?? '')?.[1];
  return x != null ? Number(x) : undefined;
};
const week14 = base.find((f) => weeksOf(b, f.period) === 14)?.period;

// ── A. capex and data-center revenue ──
const cFrom = calOf(from);
const path = capexPath(b).filter((p) => qIndex(p.period) >= qIndex(cFrom));
const rows = platformRows(b);
const calLast = calOf(fLast);
const capexFc0 = path.find((p) => p.forecast)?.period;
const levelCats = calQuarters(cFrom, path.at(-1) && qIndex(path.at(-1)!.period) > qIndex(calLast) ? path.at(-1)!.period : calLast);
const capexLine = path.map((p) => ({ x: p.period, y: p.value / 100, forecast: p.forecast }));
const dcLine = rows.filter((r) => r.dc != null).map((r) => ({ x: calOf(r.period), y: r.dc! / 100, forecast: r.forecast }));
const dcKeys = qs.map((q) => noteKey(b, q, 'platform'));
const capexKeys = path.map((p) => p.src);
const rq = derivedMap(b, 'capture-ratio-quarter');
const r4 = derivedMap(b, 'capture-ratio-4q');
const ratioCats = [...new Set([...rq.keys(), ...r4.keys()])].filter((p) => qIndex(p) >= qIndex(from)).sort((x, y) => qIndex(x) - qIndex(y));
const r4Actual = [...r4].filter(([p, v]) => v.status !== 'forecast' && qIndex(p) >= qIndex(from)).sort((x, y) => qIndex(x[0]) - qIndex(y[0]));
const r4First = r4Actual[0];
const jump = r4Actual.find(([, v]) => v.value >= 40);
const after = jump ? r4Actual.filter(([p]) => qIndex(p) >= qIndex(jump[0])).map(([, v]) => v.value) : [];
const r4Last = r4.get(last)?.value;
const r4Fc = [...r4].find(([, v]) => v.status === 'forecast');
const slope = param(b, /^資料中心營收季成長對資本支出季成長的斜率/);
const slopeSe = se(slope?.note);
const halfNote = driverOf(b, 'hyperscaler-capex-total')?.note;
const halfKey = /一半多一點/.test(halfNote ?? '') ? citesIn(b, halfNote)[0] : undefined;
const ratioBear = assumptionNum(b, 'bear', /資料中心營收占資本支出的比例/, /^([\d.]+)%/);
const ratioBase = assumptionNum(b, 'base', /資料中心營收占資本支出的比例/, /^([\d.]+)%/);
const ratioBull = assumptionNum(b, 'bull', /資料中心營收占資本支出的比例/, /^([\d.]+)%/);
const ratioWhy = /（本模型假設：([^）]+)）/.exec(assumptionOf(b, 'bear', /資料中心營收占資本支出的比例/)?.value ?? '')?.[1];

// ── B. the five companies ──
const lastActualCal = driverPts(b, 'hyperscaler-capex-total').at(-1)?.period ?? calOf(last);
const coCats = calQuarters(cFrom, lastActualCal);
const coSeries = CAPEX_COMPANIES.map((c) => {
  const mp = driverMap(b, c.id);
  return { name: c.name, color: c.color, points: coCats.map((p) => ({ x: p, y: yi(mp.get(p)?.value) })), src: mp.get(lastActualCal)?.src };
});
const coLatest = CAPEX_COMPANIES.map((c) => ({ name: c.name, p: driverMap(b, c.id).get(lastActualCal) })).filter((x) => x.p);
const coTop = [...coLatest].sort((x, y) => y.p!.value - x.p!.value)[0];
const years = capexYears(b, Number(cFrom.slice(0, 4)));
const yearBars = years.map((y) => ({
  period: y.year,
  value: y.value / 100,
  status: y.nForecast > 0 ? ('forecast' as const) : undefined,
  note:
    y.nForecast === 0
      ? undefined
      : y.nActual > 0
        ? `前 ${y.nActual} 季實際 ${n0(y.actual / 100)} 億美元＋其餘 ${y.nForecast} 季模型反推 ${n0(y.forecast / 100)} 億美元（基準情境）`
        : '基準情境（模型假設）',
}));
const yMixed = years.find((y) => y.nForecast > 0 && y.nActual > 0);
const yFc = years.find((y) => y.nActual === 0);
const yPrev = yMixed ? years.find((y) => Number(y.year) === Number(yMixed.year) - 1) : undefined;
const outlookY = (driverOf(b, 'capex-top5-outlook')?.points ?? []).filter((p) => /^\d{4}$/.test(p.period)).sort((x, y) => Number(x.period) - Number(y.period));
const guideCo = [
  { name: 'Alphabet', id: 'capex-annual-googl' },
  { name: 'Meta（含融資租賃本金）', id: 'capex-annual-meta' },
  { name: '亞馬遜', id: 'capex-annual-amzn' },
]
  .map((c) => ({ ...c, p: (driverOf(b, c.id)?.points ?? []).find((p) => p.status === 'guidance') }))
  .filter((c) => c.p);
const growth = (['bear', 'base', 'bull'] as const).map((id) => assumptionNum(b, id, /^\d{4} 年五大雲端業者資本支出/, /^年增 ([\d.]+)%/));
const growthCfo = /財務長引述/.test(assumptionOf(b, 'base', /^\d{4} 年五大雲端業者資本支出/)?.value ?? '');
const yearSrcs = years.flatMap((y) => y.srcs);

// ── C. customers and products ──
const custQs = qs.filter((q) => extraOf(q, '超大規模營收') != null);
const custSeries = [
  { name: '資料中心：超大規模', key: '超大規模營收', color: 'var(--chart-1)' },
  { name: '資料中心：ACIE', key: 'ACIE營收', color: 'var(--chart-3)' },
  { name: '邊緣運算', key: '邊緣運算營收', color: 'var(--chart-7)' },
].map((s) => ({ name: s.name, color: s.color, points: custQs.map((q) => ({ x: chartKey(q.period), y: yi(extraOf(q, s.key)) })) }));
const custKeys = custQs.map((q) => noteKey(b, q, 'newPlatform'));
const newFrom = newClassFrom(b);
const reclass = qs.find((q) => /由 ACIE 改列超大規模/.test(q.note ?? ''));
const hs = derivedMap(b, 'hyperscale-share-of-dc');
const hsFirst = custQs[0] ? hs.get(custQs[0].period)?.value : undefined;
const hsLast = hs.get(last)?.value;
const hsVals = custQs.map((q) => hs.get(q.period)?.value).filter((v): v is number => v != null);
const acie = extraOf(lastQ, 'ACIE營收');
const ago = inputs.quarters.find((x) => qIndex(x.period) === qIndex(last) - 4);
const acie0 = extraOf(ago, 'ACIE營收');
const hyp = extraOf(lastQ, '超大規模營收');
const hyp0 = extraOf(ago, '超大規模營收');
const splitQs = qs.filter((q) => extraOf(q, '資料中心運算營收') != null && extraOf(q, '資料中心網路營收') != null);
const splitSeries = [
  { name: '運算（GPU、CPU 與系統）', key: '資料中心運算營收', color: 'var(--chart-1)' },
  { name: '網路', key: '資料中心網路營收', color: 'var(--chart-4)' },
].map((s) => ({ name: s.name, color: s.color, points: splitQs.map((q) => ({ x: chartKey(q.period), y: yi(extraOf(q, s.key)) })) }));
const netShare = (q: (typeof splitQs)[number] | undefined) => {
  const c = extraOf(q, '資料中心運算營收');
  const n = extraOf(q, '資料中心網路營收');
  return c != null && n != null ? (n / (c + n)) * 100 : undefined;
};
const split0 = splitQs[0];
const netShares = splitQs.map((q) => netShare(q)).filter((v): v is number => v != null);
const split1 = splitQs.at(-1);
const splitKeys = splitQs.map((q) => noteKey(b, q, 'dcSplit'));
const split1Cfo = split1 ? /^cfo-/.test(noteKey(b, split1, 'dcSplit') ?? '') : false;
const rubin = /Vera Rubin 單季帶來近 (\d+) 億美元的季增營收（([a-z0-9-]+)）/.exec(lastQ.note ?? '');
const rubinKey = rubin && b.sourceByKey.has(rubin[2]!) ? rubin[2] : undefined;

// ── D. gross margin ──
const core = derivedMap(b, 'gm-core');
const prov = derivedMap(b, 'provision-rate');
const coreFrom = [...core.keys()].sort((x, y) => qIndex(x) - qIndex(y))[0] ?? from;
const gmCats = [...new Set([...qs.map((q) => q.period), ...base.map((f) => f.period), ...core.keys()])]
  .filter((p) => qIndex(p) >= qIndex(coreFrom) && qIndex(p) <= qIndex(fLast))
  .sort((x, y) => qIndex(x) - qIndex(y));
const gGuide = driverMap(b, 'guidance-gross-margin');
const gmSeries = [
  {
    name: `${meta.gmLabel}`,
    color: 'var(--chart-2)',
    points: gmCats.map((p) => {
      const q = quarterOf(inputs, p);
      const f = base.find((x) => x.period === p);
      return q ? { x: chartKey(p), y: actualGrossMargin(b.company, q) ?? null } : { x: chartKey(p), y: f?.grossMargin ?? null, forecast: !!f };
    }),
  },
  {
    name: '核心毛利率（提列前，本站推算）',
    color: 'var(--chart-1)',
    points: gmCats.map((p) => ({ x: chartKey(p), y: core.get(p)?.value ?? null, forecast: core.get(p)?.status === 'forecast' })),
  },
  {
    name: '上一季公布的毛利率財測中值',
    color: 'var(--chart-4)',
    points: gmCats.filter((p) => qIndex(p) <= qIndex(next)).map((p) => ({ x: chartKey(p), y: gGuide.get(p)?.value ?? null })),
  },
];
const gmQs = qs.filter((q) => qIndex(q.period) >= qIndex(coreFrom));
const gmKeys = [...gmQs.map((q) => q.src), ...gmCats.map((p) => gGuide.get(p)?.src)];
// every quarter from the first one with a provision figure (a quarter without one stays as an empty slot)
const provFirst = gmQs.find((q) => prov.has(q.period) || provisionBasis(q));
const provQs = provFirst ? gmQs.filter((q) => qIndex(q.period) >= qIndex(provFirst.period)) : [];
/** provision ÷ revenue (%) from the reported figures, so the one-decimal bars do not round the model's two-decimal value twice (FY2027 Q1: 1.348% → 1.3, not 1.35 → 1.4) */
const provRateOf = (q: (typeof provQs)[number]): number | undefined => {
  const basis = provisionBasis(q);
  const v = basis === 'total' ? extraOf(q, '存貨與超額採購承諾提列') : basis === 'writedown' ? q.inventoryWritedown : undefined;
  return v != null && q.revenue > 0 ? (v / q.revenue) * 100 : prov.get(q.period)?.value;
};
const provBars = provQs.map((q) => {
  const basis = provisionBasis(q);
  return {
    period: q.period,
    value: provRateOf(q) ?? null,
    color: basis === 'writedown' ? 'var(--c-fg-subtle)' : 'var(--chart-7)',
    note: basis === 'writedown' ? '10-Q 沒有揭露總額，改用存貨跌價（不含採購承諾，偏低）' : basis == null ? '兩種數字都沒有揭露' : undefined,
  };
});
/** reported quarters inside the core-margin line without a provision figure (FY2023 Q4), named under the chart */
const coreGaps = gmQs.filter((q) => qIndex(q.period) >= qIndex(coreFrom) && !core.has(q.period)).map((q) => q.period);
const anyWritedown = provBars.some((x) => x.color === 'var(--c-fg-subtle)');
const provKeys = provQs.filter((q) => provisionBasis(q)).map((q) => noteKey(b, q, 'provision'));
const provTop = provQs
  .map((q) => ({ q, v: provRateOf(q) }))
  .filter((x): x is { q: (typeof provQs)[number]; v: number } => x.v != null)
  .sort((x, y) => y.v - x.v)
  .slice(0, 2);
const provEvent = (q: (typeof provQs)[number]) =>
  inputs.events.find((e) => e.date >= q.start && Date.parse(e.date) <= Date.parse(q.end) + 20 * 86_400_000 && /H20|存貨|出口|低於財測/.test(e.title + e.detail));
const h20 = extraOf(provTop[0]?.q, 'H20相關費用');
const coreWin = qs.filter((q) => qIndex(q.period) >= qIndex(m.test.from)).map((q) => core.get(q.period)?.value).filter((v): v is number => v != null);
const provRateP = param(b, /^提列率（預測期）/);
const dramP = param(b, /^DRAM 合約價季變化對毛利率季變化的影響/);
const dramSe = se(dramP?.note);
const memEvent = inputs.events.find((e) => /記憶體/.test(e.title) && /毛利率/.test(e.title));
const gGm = gGuide.get(next);
const gYear = [...driverMap(b, 'guidance-gross-margin-annual').values()].filter((p) => p.status === 'guidance').at(-1);
const gm28 = (['bear', 'base', 'bull'] as const).map((id) => assumptionNum(b, id, /^FY\d{4} 毛利率/, /^([\d.]+)%/));
const idx = derivedMap(b, 'hbm-blended-price-index');
const idxPts = [...idx].sort((x, y) => qIndex(x[0]) - qIndex(y[0]));
const idxActual = idxPts.filter(([, v]) => v.status !== 'forecast');
const idx0 = idxActual[0];
const idx1 = idxActual.at(-1);
const idxFc = idxPts.find(([, v]) => v.status === 'forecast');
const idxBase = /（(\d{4}) 年第([一二三四])季 = 100）/.exec(derivedOf(b.model, 'hbm-blended-price-index')?.unit ?? '');
const ZH_Q: Record<string, number> = { 一: 1, 二: 2, 三: 3, 四: 4 };
const idxBaseLabel = idxBase ? `${idxBase[1]} Q${ZH_Q[idxBase[2]!]}` : '';
const priceSeries = b.prices.series.find((s) => s.id === 'dram-incl-hbm-contract-qoq');
const idxKeys = idx0 ? (priceSeries?.points ?? []).filter((p) => /^\d{4}Q[1-4]$/.test(p.period) && qIndex(p.period) >= qIndex(idx0[0])).map((p) => p.src) : [];
const bridgeP = derivedMap(b, 'gm-bridge-provisions');
const bridgeC = derivedMap(b, 'gm-bridge-core');
const bridgeRows = [...bridgeP.keys()]
  .filter((p) => bridgeC.has(p))
  .sort((x, y) => qIndex(x) - qIndex(y))
  .map((p) => {
    const q = quarterOf(inputs, p);
    const f = base.find((x) => x.period === p);
    return {
      period: p,
      forecast: bridgeP.get(p)!.status === 'forecast' || bridgeC.get(p)!.status === 'forecast',
      gm: q ? actualGrossMargin(b.company, q) : f?.grossMargin,
      prov: bridgeP.get(p)!.value,
      core: bridgeC.get(p)!.value,
      src: q?.src,
    };
  });
const sp = (v: number) => formatNumber(v, { digits: 2, signed: true });

// ── E. supply ──
const supQs = qs;
const supBars = supQs.map((q) => ({
  period: q.period,
  value: yi(extraOf(q, '供應與產能承諾')),
  note: extraOf(q, '供應與產能承諾') == null ? '公司只揭露含非存貨義務的總額，沒有可比數字' : undefined,
}));
/** reported quarters with no comparable commitment figure (FY2026 Q2), named under the chart */
const supGaps = supQs.filter((q) => extraOf(q, '供應與產能承諾') == null).map((q) => q.period);
const supKeys = supQs.filter((q) => extraOf(q, '供應與產能承諾') != null).map((q) => noteKey(b, q, 'supply'));
const sup1 = extraOf(lastQ, '供應與產能承諾');
const sup0 = extraOf(ago, '供應與產能承諾');
const cover = derivedMap(b, 'supply-commitment-cover').get(last)?.value;
const supEvent = inputs.events.find((e) => e.src === lastQ.src && /記憶體採購/.test(e.detail));
const constrained = inputs.events.map((e) => ({ e, m: /供給瓶頸至少延續到 (FY\d{4}) 年底/.exec(e.detail) })).find((x) => x.m);
const cowos = (driverOf(b, 'cowos-capacity-tsmc')?.points ?? []).filter((p) => /^\d{4}$/.test(p.period)).sort((x, y) => Number(x.period) - Number(y.period));
const cowosK = /^千片/.test(driverOf(b, 'cowos-capacity-tsmc')?.unit ?? '');
const cowosUnit = cowosK ? '萬片／月（12 吋晶圓）' : (driverOf(b, 'cowos-capacity-tsmc')?.unit ?? '');
const wan = (v: number) => (cowosK ? v / 10 : v);
const wanTxt = (v: number) => formatNumber(wan(v), { digits: 1, trim: true });
const cowosFc = cowos.filter((p) => p.status === 'forecast');
const gs = (driverOf(b, 'cowos-capacity-tsmc-gs')?.points ?? []).find((p) => /年增 \d+%/.test(p.note ?? '') && p.period === String(Number(calOf(last).slice(0, 4)) + 1));
const gsGrowth = gs ? /年增 (\d+)%/.exec(gs.note ?? '')?.[1] : undefined;
const nvShare = (driverOf(b, 'cowos-nvidia-share')?.points ?? []).at(-1);
const neo = (driverOf(b, 'neocloud-capacity')?.points ?? []).filter((p) => /^\d{4}$/.test(p.period)).sort((x, y) => Number(x.period) - Number(y.period));
const supplyChain = inputs.events.find((e) => /載板|封裝/.test(e.title) && /產能/.test(e.title));

// ── F. China ──
const chBill = driverMap(b, 'china-share-billing');
const chHq = driverMap(b, 'china-share-hq');
const chSeries = [
  { name: '依客戶帳單地址', color: 'var(--chart-7)', points: qs.map((q) => ({ x: chartKey(q.period), y: chBill.get(q.period)?.value ?? null })) },
  { name: '依客戶總部所在地', color: 'var(--chart-1)', points: qs.map((q) => ({ x: chartKey(q.period), y: chHq.get(q.period)?.value ?? null })) },
];
const chKeys = [...qs.map((q) => chBill.get(q.period)?.src), ...qs.map((q) => chHq.get(q.period)?.src)];
const billLast = [...chBill.values()].filter((p) => qIndex(p.period) >= qIndex(from)).at(-1);
const billMax = [...chBill.values()].filter((p) => qIndex(p.period) >= qIndex(from)).sort((x, y) => y.value - x.value)[0];
const hqLast = chHq.get(last);
const hopper = driverPts(b, 'china-dc-hopper');
const hopperLast = hopper.at(-1);
const h20Event = inputs.events.find((e) => /H20/.test(e.title) && /許可/.test(e.title));
const chinaSens = m.sensitivities.find((s) => /中國/.test(s.driver));
const hqFrom = billLast ? nextQuarter(billLast.period) : undefined;
const hqRestated = [...chHq.values()].sort((x, y) => qIndex(x.period) - qIndex(y.period))[0];
const hopperQuiet = hopper.filter((p, i) => i > 0 && p !== hopperLast && p.value === 0);
const hopperNote = driverOf(b, 'china-dc-hopper')?.note;
const hopperQuietKeys = [...new Set([...hopperQuiet.map((p) => p.src), ...citesIn(b, hopperNote)])];
const hopperUntil = hopperLast ? inputs.quarters.find((x) => qIndex(x.period) === qIndex(hopperLast.period) - 1)?.period : undefined;
const gRevNext = driverMap(b, 'guidance-revenue').get(next);
---

<h3 class="fc-h3">雲端資本支出：資料中心營收的上游</h3>
<p class="fc-p">
  選定模型的核心假設是：輝達的資料中心營收約等於五大雲端業者同期資本支出的一個比例。{r4First && jump && after.length > 0 && `四季合計的比例由 ${periodLabel(r4First[0])} 的 ${n1(r4First[1].value)}% 升到 ${periodLabel(jump[0])} 的 ${n1(jump[1].value)}%，之後在 ${n1(Math.min(...after))}–${n1(Math.max(...after))}% 之間${r4Last != null ? `（${periodLabel(last)} 為 ${n1(r4Last)}%）` : ''}。`}{slope && slopeSe != null && `逐季的成長率卻對不太上：用訓練期資料以資本支出的季成長解釋資料中心營收的季成長，斜率是 ${formatNumber(slope.value, { digits: 2 })}（標準誤 ${formatNumber(slopeSe, { digits: 2 })}），和 0 沒有顯著差異；所以模型改用四季合計的比例，而不是逐季的成長關係。`}
  {halfKey && <>這個比例不是市占率：五大雲端業者只占資料中心營收的一半多一點<FcCite k={halfKey} />，比例固定等於假設 AI 雲、產業與企業客戶也跟著同一波投資成長。</>}{ratioBase != null && ratioBear != null && ratioBull != null && `${ratioBull === ratioBase ? `基準與樂觀情境把 ${fLast.slice(0, 6)} 的比例維持在 ${n1(ratioBase)}%，保守情境降到 ${n1(ratioBear)}%` : `${fLast.slice(0, 6)} 的比例：保守 ${n1(ratioBear)}%、基準 ${n1(ratioBase)}%、樂觀 ${n1(ratioBull)}%`}${ratioWhy ? `（保守情境的假設：${ratioWhy}）` : ''}。`}
</p>
