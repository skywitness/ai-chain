---
/**
 * AI-server division of labour in Taiwan: chip → board → L6 → L10 → L11 rack, each stage with a pictogram,
 * a short explanation and representative Taiwan company chips (roster ids; unknown ids are dropped).
 * A horizontal flow on wide screens, a vertical one below 1100px. Semantics: an ordered list.
 *   <ServerDivision />
 */
import TwChip from './TwChip.astro';
import { SERVER_STAGES, stageCompanies } from './taiwan-data';

interface Props {
  class?: string | undefined;
}
const { class: className } = Astro.props;
const stages = SERVER_STAGES.map((s) => ({ ...s, list: stageCompanies(s) }));

// 48×48 pictograms, stroke = currentColor (decorative)
const ICONS: Record<string, string> = {
  chip: '<rect x="14" y="14" width="20" height="20" rx="2"/><rect x="19" y="19" width="10" height="10" rx="1" fill="currentColor" fill-opacity=".25"/><path d="M19 10v4M24 10v4M29 10v4M19 34v4M24 34v4M29 34v4M10 19h4M10 24h4M10 29h4M34 19h4M34 24h4M34 29h4"/>',
  board: '<rect x="6" y="12" width="36" height="24" rx="2"/><rect x="11" y="17" width="8" height="8" rx="1"/><path d="M24 17h13M24 21h13M24 25h9M11 30h26"/>',
  l6: '<rect x="5" y="10" width="38" height="28" rx="2"/><rect x="10" y="15" width="12" height="12" rx="1" fill="currentColor" fill-opacity=".25"/><rect x="26" y="15" width="12" height="12" rx="1" fill="currentColor" fill-opacity=".25"/><path d="M10 32h28"/>',
  l10: '<rect x="4" y="16" width="40" height="16" rx="2"/><path d="M9 21h12M9 27h12"/><circle cx="35" cy="24" r="3"/><path d="M27 21v6"/>',
  l11: '<rect x="13" y="4" width="22" height="40" rx="2"/><path d="M17 10h14M17 15h14M17 20h14M17 25h14M17 30h14M17 35h14"/><path d="M13 40h22"/>',
};
---

<div class:list={['sd', className]}>
  <ol class="sd__list" role="list">
    {
      stages.map((s, i) => (
        <li class="sd__stage" data-stage={s.id}>
          <div class="sd__head">
            <span class="sd__icon" aria-hidden="true">
              <svg viewBox="0 0 48 48" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[s.id]} />
            </span>
            <span class="sd__step">
              <span class="sr-only">第 {i + 1} 段：</span>
              {s.step}
            </span>
          </div>
          <h3 class="sd__title">{s.title}</h3>
          <p class="sd__summary">{s.summary}</p>
          <p class="sd__detail">{s.detail}</p>
          {s.list.length > 0 && (
            <div class="sd__cos">
              <p class="sd__cos-label">代表台廠</p>
              <span class="sd__chips">
                {s.list.map((c) => (
                  <TwChip company={c} />
                ))}
              </span>
            </div>
          )}
        </li>
      ))
    }
  </ol>
</div>

<style>
  .sd__list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: sd;
  }
  .sd__stage {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) var(--space-5);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-l);
    background: var(--c-bg-elev);
    box-shadow: var(--shadow-1);
    min-width: 0;
  }
  /* connector arrows between stages */
  .sd__stage:not(:last-child)::after {
    content: '';
    position: absolute;
    inset-inline-start: 2.6rem;
    inset-block-end: calc(-1 * var(--space-4) - 1px);
    inline-size: 2px;
    block-size: var(--space-4);
    background: var(--c-border-strong);
  }
  .sd__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .sd__icon {
    display: grid;
    place-items: center;
    inline-size: 3.25rem;
    block-size: 3.25rem;
    border-radius: var(--radius-m);
    background: color-mix(in srgb, var(--c-accent) 9%, var(--c-bg));
    color: var(--c-accent);
  }
  .sd__stage[data-stage='chip'] .sd__icon {
    color: var(--seg-foundry-packaging);
    background: color-mix(in srgb, var(--seg-foundry-packaging) 10%, var(--c-bg));
  }
  .sd__stage[data-stage='board'] .sd__icon {
    color: var(--seg-semi-equipment-materials);
    background: color-mix(in srgb, var(--seg-semi-equipment-materials) 10%, var(--c-bg));
  }
  .sd__stage[data-stage='l6'] .sd__icon,
  .sd__stage[data-stage='l10'] .sd__icon {
    color: var(--seg-servers-systems);
    background: color-mix(in srgb, var(--seg-servers-systems) 10%, var(--c-bg));
  }
  .sd__stage[data-stage='l11'] .sd__icon {
    color: var(--seg-datacenter-infra);
    background: color-mix(in srgb, var(--seg-datacenter-infra) 10%, var(--c-bg));
  }
  .sd__step {
    padding: 0.1em 0.6em;
    border-radius: var(--radius-pill);
    background: var(--c-fg);
    color: var(--c-bg);
    font-size: var(--fs-s);
    font-weight: var(--fw-bold);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }
  .sd__title {
    margin: var(--space-1) 0 0;
    font-size: var(--fs-l);
    line-height: 1.4;
  }
  .sd__summary {
    margin: 0;
    font-size: var(--fs-s);
    font-weight: var(--fw-semibold);
    color: var(--c-fg-muted);
  }
  .sd__detail {
    margin: 0;
    font-size: var(--fs-s);
    line-height: 1.75;
    color: var(--c-fg-muted);
  }
  .sd__cos {
    display: grid;
    gap: var(--space-2);
    margin-block-start: var(--space-2);
    padding-block-start: var(--space-3);
    border-block-start: 1px dashed var(--c-border);
  }
  .sd__cos-label {
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--c-fg-subtle);
  }
  .sd__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  @media (min-width: 1100px) {
    .sd__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--space-5);
    }
    .sd__stage:not(:last-child)::after {
      inset-inline-start: auto;
      inset-inline-end: calc(-1 * var(--space-5));
      inset-block-start: 2.6rem;
      inset-block-end: auto;
      inline-size: var(--space-5);
      block-size: 2px;
    }
    .sd__stage:not(:last-child)::before {
      content: '';
      position: absolute;
      inset-inline-end: calc(-1 * var(--space-5) + 1px);
      inset-block-start: calc(2.6rem - 4px);
      border: 5px solid transparent;
      border-inline-start: 7px solid var(--c-border-strong);
      border-inline-end: 0;
      z-index: 1;
    }
  }
</style>
