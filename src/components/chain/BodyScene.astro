---
/**
 * <Scene3D> for MDX bodies on pages that already autoload a scene in their hero (segment pages,
 * /chain/, the home page): passes every prop through but forces autoload="click", so a page never
 * autoloads more than one scene whatever the body says.
 *   <Content components={{ ...mdxComponents, Scene3D: BodyScene }} />
 */
import type { ComponentProps } from 'astro/types';
import Scene3D from '../scene/Scene3D.astro';

type Props = ComponentProps<typeof Scene3D>;
const props = Astro.props;
---

<Scene3D {...props} autoload="click" />
