---
/**
 * Section heading block shared by the home and chain pages: kicker, H2, lede and an optional link.
 *   <SectionHead id="key-numbers" kicker="用數字看產業鏈" title="關鍵數字" lede="…" href={…} linkLabel="看全部" />
 * The lede may also come from the default slot.
 */
import Icon from '../ui/Icon.astro';

interface Props {
  id: string;
  title: string;
  kicker?: string | undefined;
  lede?: string | undefined;
  href?: string | undefined;
  linkLabel?: string | undefined;
  as?: 'h2' | 'h3' | undefined;
  /** CSS colour of the small rule above the kicker */
  accent?: string | undefined;
  class?: string | undefined;
}
const { id, title, kicker, lede, href, linkLabel = '查看全部', as: H = 'h2', accent, class: className } = Astro.props;
const hasSlot = Astro.slots.has('default');
---

<div class:list={['sh', className]} style={accent ? `--sh-accent: ${accent}` : undefined}>
  <div class="sh__text">
    {kicker && <p class="sh__kicker">{kicker}</p>}
    <H id={id} class="sh__title">{title}</H>
    {lede && <p class="sh__lede">{lede}</p>}
    {hasSlot && <div class="sh__lede"><slot /></div>}
  </div>
  {
    href && (
      <a class="sh__link" href={href}>
        {linkLabel}
        <Icon name="arrow-right" />
      </a>
    )
  }
</div>

<style>
  .sh {
    --sh-accent: var(--c-accent);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin-block-end: var(--space-5);
  }
  .sh__text {
    display: grid;
    gap: var(--space-2);
    max-width: 46rem;
    min-width: 0;
  }
  .sh__kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--c-fg-subtle);
  }
  .sh__kicker::before {
    content: '';
    inline-size: 1.25rem;
    block-size: 3px;
    border-radius: 2px;
    background: var(--sh-accent);
  }
  .sh__title {
    font-size: var(--fs-2xl);
    line-height: 1.3;
    text-wrap: balance;
    scroll-margin-top: calc(var(--header-h) + var(--space-4));
  }
  h3.sh__title {
    font-size: var(--fs-xl);
  }
  .sh__lede {
    color: var(--c-fg-muted);
    line-height: 1.75;
    max-width: var(--measure);
  }
  .sh__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-block-size: var(--tap);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-s);
    text-decoration: none;
    white-space: nowrap;
  }
  .sh__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
