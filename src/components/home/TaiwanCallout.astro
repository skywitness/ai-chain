---
/**
 * Home callout for the Taiwan supply chain: company count, the segments with the most Taiwanese
 * companies (mini bars), the largest companies by TTM revenue and a link to /taiwan/.
 *   <TaiwanCallout summary={await getTaiwanSummary()} />
 */
import Button from '../ui/Button.astro';
import { companyHref, sectionHref, segmentHref } from '../../lib/paths';
import type { TaiwanSummary } from './home-data';

interface Props {
  summary: TaiwanSummary;
}
const { summary } = Astro.props;
const bars = summary.bySegment.slice(0, 5);
const max = Math.max(1, ...bars.map((b) => b.count));
---

<section class="callout-tw" aria-labelledby="home-taiwan">
  <p class="co__kicker">台灣供應鏈</p>
  <h2 id="home-taiwan" class="co__title">從晶圓、封裝到整櫃伺服器，台灣站在 AI 算力的中心</h2>
  <p class="co__text">
    最先進的 AI 晶片幾乎都在台灣製造與封裝，AI 伺服器也大多由台灣廠商組裝出貨。看看台灣公司分布在哪些環節、各自扮演什麼角色。
  </p>
  <div class="co__stats">
    <p class="co__stat">
      <strong>{summary.count}</strong>
      <span>家台灣公司</span>
    </p>
    {
      summary.sites != null && (
        <p class="co__stat">
          <strong>{summary.sites}</strong>
          <span>個園區與產業聚落</span>
        </p>
      )
    }
  </div>
  <div class="co__bars">
    <p class="co__sub" id="home-tw-bars">台灣公司最多的環節</p>
    <ol class="co__barlist" role="list" aria-labelledby="home-tw-bars">
      {
        bars.map((b) => (
          <li style={`--w: ${(b.count / max) * 100}%; --bc: var(--seg-${b.id})`}>
            <a href={segmentHref(b.id)} class="co__bar-label">
              {b.title}
            </a>
            <span class="co__bar-track" aria-hidden="true">
              <span class="co__bar" />
            </span>
            <span class="co__bar-n">{b.count} 家</span>
          </li>
        ))
      }
    </ol>
  </div>
  {
    summary.top.length > 0 && (
      <div>
        <p class="co__sub">近四季營收最大的台灣公司</p>
        <ul class="co__chips" role="list">
          {summary.top.slice(0, 8).map((c) => (
            <li>
              <a href={companyHref(c.id)} style={`--cc: var(--seg-${c.segment})`}>
                {c.nameZh}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
  <div class="co__cta">
    <Button href={sectionHref('taiwan')} variant="primary" icon="arrow-right" iconPosition="end">台灣 AI 供應鏈</Button>
  </div>
</section>

<style>
  .callout-tw {
    --co-c: var(--scene-tw-accent);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border-radius: var(--radius-l);
    border: 1px solid color-mix(in srgb, var(--co-c) 25%, var(--c-border));
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--co-c) 12%, transparent), transparent 60%),
      var(--c-bg-elev);
    min-width: 0;
  }
  .co__kicker {
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-wide);
    color: color-mix(in srgb, var(--co-c) 80%, var(--c-fg));
  }
  .co__title {
    font-size: var(--fs-xl);
    line-height: 1.4;
    text-wrap: balance;
    margin-block-start: calc(-1 * var(--space-2));
  }
  .co__text {
    color: var(--c-fg-muted);
    line-height: 1.75;
    font-size: var(--fs-s);
  }
  .co__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }
  .co__stat {
    display: grid;
  }
  .co__stat strong {
    font-size: var(--fs-2xl);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .co__stat span {
    font-size: var(--fs-xs);
    color: var(--c-fg-subtle);
  }
  .co__sub {
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    color: var(--c-fg-subtle);
    margin-block-end: var(--space-2);
  }
  .co__barlist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .co__barlist li {
    display: grid;
    grid-template-columns: 6.5em minmax(0, 1fr) 3.2em;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--fs-s);
  }
  .co__bar-label {
    color: var(--c-fg);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .co__bar-label:hover {
    color: var(--c-link);
    text-decoration: underline;
  }
  .co__bar-track {
    block-size: 10px;
    border-radius: 5px;
    background: var(--c-bg-sunken);
    overflow: hidden;
  }
  .co__bar {
    display: block;
    block-size: 100%;
    inline-size: var(--w);
    border-radius: 5px;
    background: var(--bc);
  }
  .co__bar-n {
    font-size: var(--fs-xs);
    color: var(--c-fg-muted);
    text-align: end;
    font-variant-numeric: tabular-nums;
  }
  .co__chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .co__chips a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-block-size: 36px;
    padding: 2px var(--space-3);
    border-radius: var(--radius-pill);
    border: 1px solid var(--c-border);
    background: var(--c-bg);
    color: var(--c-fg);
    font-size: var(--fs-s);
    text-decoration: none;
  }
  .co__chips a::before {
    content: '';
    inline-size: 0.5em;
    block-size: 0.5em;
    border-radius: 50%;
    background: var(--cc);
  }
  .co__chips a:hover {
    border-color: var(--c-border-strong);
  }
  .co__cta {
    margin-block-start: auto;
    padding-block-start: var(--space-2);
  }
</style>
