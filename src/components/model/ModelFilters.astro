---
/**
 * Filter bar for the model-family directory on /models/ (類型／來源地／開放程度).
 * Progressive enhancement: every card is server-rendered; this form (shown only with JS) toggles
 * `hidden` on `[data-model-card]` items inside `target`, hides groups that end up empty
 * (`[data-model-group]`), updates the live count and syncs ?kind= &origin= &open= in the URL.
 *
 *   <ModelFilters target="model-directory" total={48} kinds={[…]} origins={[…]} />
 */
interface Option {
  id: string;
  label: string;
  count: number;
}
interface Props {
  /** id of the element that contains the cards */
  target: string;
  total: number;
  kinds: Option[];
  origins: Option[];
  openness: Option[];
}
const { target, total, kinds, origins, openness } = Astro.props;
const groups: Array<{ name: string; legend: string; options: Option[] }> = [
  { name: 'kind', legend: '類型', options: kinds },
  { name: 'origin', legend: '來源地', options: origins },
  { name: 'open', legend: '開放程度', options: openness },
];
---

<form class="mflt" data-model-filters data-target={target} aria-label="篩選模型系列" data-pagefind-ignore>
  {
    groups.map((g) => (
      <fieldset class="mflt__group">
        <legend class="mflt__legend">{g.legend}</legend>
        <div class="mflt__opts">
          <label class="mflt__opt">
            <input type="radio" name={g.name} value="" checked />
            <span>全部</span>
          </label>
          {g.options
            .filter((o) => o.count > 0)
            .map((o) => (
              <label class="mflt__opt">
                <input type="radio" name={g.name} value={o.id} />
                <span>
                  {o.label}
                  <small aria-hidden="true">{o.count}</small>
                </span>
              </label>
            ))}
        </div>
      </fieldset>
    ))
  }
  <div class="mflt__foot">
    <p class="mflt__count" aria-live="polite">
      顯示 <strong data-count>{total}</strong>／{total} 個系列
    </p>
    <button type="reset" class="mflt__reset">清除篩選</button>
  </div>
</form>
<p class="mflt__empty" data-model-empty hidden>
  沒有符合條件的模型系列。請放寬篩選條件，或<button type="button" class="mflt__link" data-model-reset>清除篩選</button>。
</p>

<script>
  const KEYS = ['kind', 'origin', 'open'] as const;
  type Key = (typeof KEYS)[number];

  function init(form: HTMLFormElement) {
    const root = document.getElementById(form.dataset['target'] ?? '');
    if (!root) return;
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-model-card]'));
    const groups = Array.from(root.querySelectorAll<HTMLElement>('[data-model-group]'));
    const countEl = form.querySelector<HTMLElement>('[data-count]');
    const empty = form.nextElementSibling instanceof HTMLElement && form.nextElementSibling.matches('[data-model-empty]') ? form.nextElementSibling : null;

    const value = (k: Key) => (form.elements.namedItem(k) as RadioNodeList | null)?.value ?? '';

    const apply = (sync: boolean) => {
      const sel = { kind: value('kind'), origin: value('origin'), open: value('open') };
      let shown = 0;
      for (const el of items) {
        const ok = KEYS.every((k) => !sel[k] || el.dataset[k] === sel[k]);
        el.hidden = !ok;
        if (ok) shown++;
      }
      for (const g of groups) {
        g.hidden = !g.querySelector('[data-model-card]:not([hidden])');
        const n = g.querySelector<HTMLElement>('[data-group-count]');
        if (n) n.textContent = String(g.querySelectorAll('[data-model-card]:not([hidden])').length);
      }
      if (countEl) countEl.textContent = String(shown);
      if (empty) empty.hidden = shown > 0;
      if (sync) {
        try {
          const url = new URL(window.location.href);
          for (const k of KEYS) {
            if (sel[k]) url.searchParams.set(k, sel[k]);
            else url.searchParams.delete(k);
          }
          history.replaceState(history.state, '', url);
        } catch {
          /* ignore */
        }
      }
    };

    // initial state from the URL
    try {
      const params = new URLSearchParams(window.location.search);
      for (const k of KEYS) {
        const v = params.get(k);
        if (!v) continue;
        const input = form.querySelector<HTMLInputElement>(`input[name="${k}"][value="${CSS.escape(v)}"]`);
        if (input) input.checked = true;
      }
    } catch {
      /* ignore */
    }
    form.addEventListener('change', () => apply(true));
    form.addEventListener('reset', () => window.setTimeout(() => apply(true), 0));
    form.addEventListener('submit', (e) => e.preventDefault());
    empty?.querySelector('[data-model-reset]')?.addEventListener('click', () => form.reset());
    apply(false);
  }

  document.querySelectorAll<HTMLFormElement>('form[data-model-filters]').forEach(init);
</script>

<style>
  @layer components {
    .mflt {
      display: grid;
      gap: var(--space-3);
      padding: var(--space-4) var(--space-5);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-l);
      background: var(--c-bg-elev);
    }
    :global(html:not(.js)) .mflt {
      display: none;
    }
    .mflt__group {
      margin: 0;
      padding: 0;
      border: 0;
      min-width: 0;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
    }
    @media (min-width: 768px) {
      .mflt__group {
        grid-template-columns: 5.5em minmax(0, 1fr);
        align-items: center;
      }
    }
    .mflt__legend {
      float: left;
      padding: 0;
      font-size: var(--fs-s);
      font-weight: var(--fw-semibold);
      color: var(--c-fg-muted);
    }
    .mflt__opts {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
    .mflt__opt {
      position: relative;
      display: inline-flex;
    }
    .mflt__opt input {
      position: absolute;
      opacity: 0;
      inset: 0;
      margin: 0;
      cursor: pointer;
    }
    .mflt__opt span {
      display: inline-flex;
      align-items: center;
      gap: 0.45em;
      min-block-size: 2.5rem;
      padding: 0.3em 0.95em;
      border: 1px solid var(--c-border);
      border-radius: var(--radius-pill);
      background: var(--c-bg);
      font-size: var(--fs-s);
      color: var(--c-fg);
      cursor: pointer;
      transition:
        background var(--dur-1) ease,
        border-color var(--dur-1) ease;
    }
    .mflt__opt small {
      font-size: var(--fs-xs);
      color: var(--c-fg-subtle);
      font-variant-numeric: tabular-nums;
    }
    .mflt__opt:hover span {
      border-color: var(--c-border-strong);
    }
    .mflt__opt input:checked + span {
      background: var(--c-accent);
      border-color: var(--c-accent);
      color: var(--c-accent-fg);
    }
    .mflt__opt input:checked + span small {
      color: inherit;
      opacity: 0.8;
    }
    .mflt__opt input:focus-visible + span {
      outline: 2px solid var(--c-focus);
      outline-offset: 2px;
    }
    .mflt__foot {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2);
      padding-block-start: var(--space-3);
      border-block-start: 1px solid var(--c-border);
    }
    .mflt__count {
      font-size: var(--fs-s);
      color: var(--c-fg-muted);
    }
    .mflt__count strong {
      color: var(--c-fg);
      font-variant-numeric: tabular-nums;
    }
    .mflt__reset,
    .mflt__link {
      min-block-size: 2.75rem;
      padding: 0 var(--space-3);
      border: 0;
      background: none;
      color: var(--c-link);
      font: inherit;
      font-size: var(--fs-s);
      text-decoration: underline;
      text-underline-offset: 0.2em;
      cursor: pointer;
    }
    .mflt__link {
      min-block-size: auto;
      padding: 0;
    }
    .mflt__empty {
      margin-block-start: var(--space-4);
      padding: var(--space-5);
      border: 1px dashed var(--c-border-strong);
      border-radius: var(--radius-l);
      text-align: center;
      color: var(--c-fg-muted);
    }
  }
</style>
