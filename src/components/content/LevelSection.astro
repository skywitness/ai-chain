---
/**
 * Levelled section for segment pages (由淺入深).
 *   <LevelSection level={1} title="這一環在做什麼">…</LevelSection>
 * Renders <section> with an H2 (id defaults to `level-<n>`) and a 入門／進階／深入 badge.
 * Use H3 (###) for sub-headings inside. For a TOC entry, add { depth: 2, slug: 'level-1', text: title }.
 */
import { levelMeta } from '../../lib/collections';

interface Props {
  level: 1 | 2 | 3;
  title: string;
  id?: string | undefined;
  class?: string | undefined;
}
const { level, title, id, class: className } = Astro.props;
const lv = levelMeta(level);
const hid = id ?? `level-${lv.level}`;
---

<section class:list={['level-section', className]} data-level={lv.level} style={`--lv: ${lv.color}`} aria-labelledby={hid}>
  <header class="level-section__head">
    <span class="level-section__badge" aria-hidden="true">
      <span class="level-section__steps">{[1, 2, 3].map((i) => <span class:list={{ on: i <= lv.level }} />)}</span>
      {lv.label}
    </span>
    <h2 id={hid} class="level-section__title"><span class="sr-only">{lv.label}：</span>{title}</h2>
  </header>
  <div class="level-section__body prose-flow">
    <slot />
  </div>
</section>

<style>
  @layer components {
    .level-section {
      position: relative;
      margin-block: 3em 0;
      padding-block-start: var(--space-5);
      border-block-start: 1px solid var(--c-border);
    }
    .level-section__head {
      display: grid;
      gap: var(--space-2);
      margin-block-end: var(--space-4);
    }
    .level-section__badge {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      justify-self: start;
      padding: 0.15em 0.7em 0.15em 0.55em;
      border-radius: var(--radius-pill);
      background: color-mix(in srgb, var(--lv) 12%, transparent);
      color: var(--lv);
      font-size: var(--fs-xs);
      font-weight: var(--fw-bold);
      letter-spacing: var(--tracking-wide);
    }
    .level-section__steps {
      display: inline-flex;
      gap: 2px;
      align-items: flex-end;
    }
    .level-section__steps > span {
      inline-size: 4px;
      border-radius: 1px;
      background: color-mix(in srgb, var(--lv) 30%, transparent);
    }
    .level-section__steps > span:nth-child(1) {
      block-size: 6px;
    }
    .level-section__steps > span:nth-child(2) {
      block-size: 9px;
    }
    .level-section__steps > span:nth-child(3) {
      block-size: 12px;
    }
    .level-section__steps > span.on {
      background: var(--lv);
    }
    .level-section__title {
      font-size: var(--fs-2xl);
      line-height: 1.3;
      padding: 0;
      max-width: var(--measure);
    }
    .level-section__title::before {
      display: none;
    }
    .level-section__body > :global(* + *) {
      margin-block-start: 1.15em;
    }
    .level-section__body > :global(h3) {
      margin-block-start: 2em;
    }
    .level-section__body > :global(h3 + *) {
      margin-block-start: 0.75em;
    }
  }
</style>
