{
  "extends": "astro/tsconfigs/strictest",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "research",
    "node_modules",
    "artifacts"
  ],
  "compilerOptions": {
    "paths": {
      "@lib/*": [
        "./src/lib/*"
      ],
      "@schemas/*": [
        "./src/schemas/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@layouts/*": [
        "./src/layouts/*"
      ],
      "@three/*": [
        "./src/three/*"
      ],
      "@data/*": [
        "./src/data/*"
      ],
      "@styles/*": [
        "./src/styles/*"
      ]
    }
  }
}
