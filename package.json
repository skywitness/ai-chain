{
  "name": "ai-chain-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI 產業鏈全景：由淺入深認識 AI 產業鏈、公司、模型與趨勢",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "build:astro": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "validate": "tsx scripts/validate-data.ts",
    "validate:files": "tsx scripts/validate-data.ts --only",
    "lint:zh": "tsx scripts/check-zh.ts",
    "lint:content": "tsx scripts/check-content-rules.ts",
    "gen:geo": "tsx scripts/gen-geo.ts",
    "coverage": "tsx scripts/report-coverage.ts",
    "links": "tsx scripts/check-links.ts",
    "test:e2e": "playwright test tests/e2e",
    "test:scene": "playwright test tests/scenes --config tests/scenes/playwright.config.ts",
    "posters": "tsx scripts/capture-posters.ts",
    "shots": "tsx scripts/capture-screenshots.ts",
    "fx": "tsx scripts/fetch-fx.ts",
    "test:a11y": "playwright test tests/a11y",
    "budgets": "tsx scripts/check-budgets.ts",
    "posters:verify": "tsx scripts/capture-posters.ts --verify",
    "verify:static": "npm run check && npm run validate && npm run lint:zh && npm run lint:content",
    "verify:dist": "npm run links && npm run budgets && npm run posters:verify",
    "check:roster": "tsx scripts/check-roster.ts",
    "harvest:fin": "tsx scripts/harvest/fin.ts",
    "harvest:build": "tsx scripts/harvest/build-financials.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.6",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-format": "^3.0.4",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/three": "0.186.0",
    "@types/topojson-client": "^3.1.5",
    "d3-array": "^3.2.4",
    "d3-format": "^3.1.2",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "linkinator": "^8.1.0",
    "opencc-js": "^1.4.2",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "sharp": "^0.35.5",
    "taiwan-atlas": "^2021.9.20",
    "temml": "^0.13.5",
    "tinyglobby": "^0.2.17",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "world-atlas": "^2.0.2",
    "yaml": "^2.9.1"
  }
}
